# Zależności — odtwarzane przez `npm install`, nie trzymamy ich w repozytorium
node_modules/
web/node_modules/

# Wynik budowania — generowany przez GitHub Actions przy każdym wdrożeniu
web/dist/
web/.astro/
dist/

# Zdjęcia w rozdzielczości aparatowej — 629 MB, pojedyncze ujęcie do 25 MB.
# Do serwisu idzie wyłącznie wynik z web/narzedzia/zdjecia.mjs, czyli WebP
# w web/public/zdjecia (razem ok. 1,5 MB). Oryginały zostają na dysku:
# repozytorium Git nigdy nie zapomina dużego pliku, nawet po jego usunięciu.
zdjęcia/
tmp_ppt_broszury/

# Baza placówek do kontaktu zawiera nazwiska dyrektorów pobrane z RSPO.
# To dane osobowe — nie trzymamy ich w repozytorium kodu, bo historia Gita
# jest trwała, a uprawnienia do repozytorium to nie to samo co podstawa
# przetwarzania. Pliki zostają lokalnie.
baza-placowek/

# Pliki lokalne i systemowe
.DS_Store
Thumbs.db
.thumbnail
*.log
npm-debug.log*

# Skille instalowane poleceniem `npx skills add`. Prawdziwe pliki leżą
# w .agents/skills i to one są w repozytorium. Katalog poniżej to wyłącznie
# dowiązania, które CLI tworzy pod Claude Code — ścieżkami BEZWZGLĘDNYMI
# tej maszyny, więc u kogokolwiek innego byłyby martwe. Po sklonowaniu
# repozytorium odtwarza je `npx skills add supabase/agent-skills`.
.claude/skills/

# Ustawienia lokalne Claude Code (mogą zawierać ścieżki z tej maszyny)
.claude/settings.local.json

# Kroje zmienne są w tym projekcie świadomie wyłączone. Serwis hostuje kroje
# u siebie, w web/public/fonts, i używa wyłącznie odmian statycznych. Ta reguła
# pilnuje, żeby plik zmienny nie trafił tam przez przypadek — katalogi źródłowe
# (assets/fonts, Quicksand) zostają nietknięte.
web/public/fonts/*Variable*
web/public/fonts/*-VF.*

# Katalog roboczy CLI Supabase — zawiera dowiązanie do projektu i znaczniki
# wersji, odtwarzane przy każdym uruchomieniu.
supabase/.temp/

# Kroje pisma w pełnym zestawie łacińskim, przed ograniczeniem do polskich
# znaków. Trzymamy je poza `public/`, żeby nie pojechały na serwer razem
# z ograniczonymi — 204 kB martwego balastu przy każdym wdrożeniu. Do
# repozytorium też nie trafiają: da się je pobrać z Google Fonts na nowo,
# a `narzedzia/fonty-ogranicz.mjs` opisuje, jak z nich zejść do zestawu
# używanego przez serwis.
web/fonty-zrodlowe/

# Wzorce do porównywania wyglądu — setki obrazów podmienianych przy każdej
# zmianie stylu. Sensowne lokalnie, przed wysłaniem zmian; w repozytorium
# byłyby wyłącznie balastem. Odtwarza je `npm run test:wyglad -- --zapisz`.
web/wzorce-wygladu/
