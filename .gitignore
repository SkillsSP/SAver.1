# Zależności — odtwarzane przez `npm install`, nie trzymamy ich w repozytorium
node_modules/
web/node_modules/

# Wynik budowania — generowany przez GitHub Actions przy każdym wdrożeniu
web/dist/
web/.astro/
dist/

# Pliki lokalne i systemowe
.DS_Store
Thumbs.db
.thumbnail
*.log
npm-debug.log*

# Ustawienia lokalne Claude Code (mogą zawierać ścieżki z tej maszyny)
.claude/settings.local.json

# Kroje zmienne są w tym projekcie świadomie wyłączone. Serwis pobiera kroje
# z Google Fonts, wypisując wagi pojedynczo (nie zakresem), więc dostaje pliki
# statyczne. Gdyby ktoś wrócił do hostowania u siebie, ta reguła pilnuje, żeby
# nie wrzucić pliku zmiennego. Pliki w assets/fonts/ zostają nietknięte.
web/public/fonts/*Variable*
web/public/fonts/*-VF.*
