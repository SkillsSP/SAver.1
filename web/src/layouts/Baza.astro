---
import Naglowek from "../components/Naglowek.astro";
import PasekUzytkowy from "../components/PasekUzytkowy.astro";
import Stopka from "../components/Stopka.astro";
import PasekAkcji from "../components/PasekAkcji.astro";
import ZgodaCookies from "../components/ZgodaCookies.astro";
import NaGore from "../components/NaGore.astro";
import { firma, url, analityka } from "../lib/site.js";
import "../styles/style.css";

interface Props {
  tytul: string;
  /** Pary pytanie–odpowiedź do danych strukturalnych. */
  pytania?: { pytanie: string; odpowiedz: string }[];
  /** Ścieżka okruszków: kolejne poziomy od strony głównej do bieżącej. */
  okruszki?: { nazwa: string; href?: string }[];
  /** Strona gotowa, ale jeszcze niepublikowana — prosimy wyszukiwarki o pominięcie. */
  bezIndeksowania?: boolean;
  opis: string;
  aktywna?: string;
  /** Rejestr Teens Senior: slate, wyłącznie Lexend, bez Quicksand. */
  senior?: boolean;
}

const {
  tytul,
  opis,
  aktywna = "",
  senior = false,
  pytania,
  okruszki,
  bezIndeksowania = false,
} = Astro.props;
/* Tytuł strony w wynikach wyszukiwania jest ucinany mniej więcej po
   sześćdziesięciu pięciu znakach. Domyślnie doklejamy nazwę i miasto, bo
   przy centrum działającym w jednym mieście nazwa miasta w tytule realnie
   pracuje na wyniki lokalne. Gdy tytuł podstrony jest długi, miasto wypada
   jako pierwsze — zostaje w opisie strony, w danych strukturalnych i w treści,
   więc sygnał lokalny nie znika, a tytuł przestaje się urywać w połowie. */
const LIMIT_TYTULU = 65;
const zNazwaIMiastem = `${tytul} · ${firma.nazwa} ${firma.miasto}`;
const pelnyTytul =
  zNazwaIMiastem.length <= LIMIT_TYTULU
    ? zNazwaIMiastem
    : `${tytul} · ${firma.nazwa}`;

/* Adres kanoniczny tej strony — bez ukośnika na końcu, żeby wyszukiwarka nie
   widziała dwóch adresów tej samej treści. */
const kanoniczny = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site).href;

/* Znacznik dla wyszukiwarki. Budujemy go wyłącznie z danych, które są już
   uzupełnione — pusty adres albo telefon „do uzupełnienia" w danych
   strukturalnych szkodzi bardziej niż ich brak, bo Google porównuje je
   z wizytówką. Kolejne pola dopisują się same, gdy wypełnicie src/lib/site.js. */
const znacznik = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: firma.nazwa,
  description: firma.podtytul,
  url: new URL(url("/"), Astro.site).href,
  logo: new URL(url("/logo/skills-academy-logo.svg"), Astro.site).href,
  areaServed: firma.miasto,
  /* Dane strukturalne chcą numeru w postaci międzynarodowej — wyszukiwarka
     dopasowuje go do wizytówki, a „508 069 007" bez kierunkowego jest dla niej
     numerem nieokreślonego kraju. */
  ...(firma.telefonZapis || firma.telefon
    ? { telephone: firma.telefonZapis ?? firma.telefon }
    : {}),
  ...(firma.email ? { email: firma.email } : {}),
  address: {
    "@type": "PostalAddress",
    addressLocality: firma.miasto,
    addressCountry: "PL",
    ...(firma.ulica ? { streetAddress: firma.ulica } : {}),
    ...(firma.kodPocztowy ? { postalCode: firma.kodPocztowy } : {}),
  },
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* POLITYKA BEZPIECZEŃSTWA TREŚCI

        Mówi przeglądarce, skąd wolno wczytywać zasoby. Gdyby ktoś wstrzyknął
        na stronę obcy skrypt — przez cudzy pakiet, przejęte konto w repozytorium
        albo błąd w kodzie — przeglądarka odmówi jego wczytania, bo adres nie
        stoi na tej liście.

        Normalnie taką politykę wysyła serwer w nagłówku odpowiedzi. GitHub
        Pages nie pozwala ustawiać własnych nagłówków, więc zostaje znacznik
        w kodzie strony. Działa tak samo, z dwoma wyjątkami: nie obsługuje
        `frame-ancestors` ani `report-uri`. Pierwszy zastępujemy niżej,
        drugiego i tak nie mamy gdzie zbierać.

        `'unsafe-inline'` przy skryptach jest tu konieczne i nie udaję, że nie:
        Astro umieszcza kod komponentów wprost w stronie, a bez własnego serwera
        nie da się nadać im jednorazowego identyfikatora. Adres analityki bierze
        się z jednego miejsca w site.js, więc po zmianie dostawcy polityka
        zmienia się razem z nim i nie trzeba pamiętać o dwóch plikach. */}
    <meta
      http-equiv="Content-Security-Policy"
      content={[
        "default-src 'self'",
        `script-src 'self' 'unsafe-inline' ${new URL(analityka.src).origin}`,
        `connect-src 'self' ${[
          new URL(analityka.src).origin,
          ...(analityka.polaczenia ?? []),
          new URL(firma.formularzEndpoint).origin,
        ].join(" ")}`,
        "style-src 'self' 'unsafe-inline'",
        "img-src 'self' data:",
        "font-src 'self'",
        /* Strona nie ma osadzanych ramek ani wtyczek — zamykamy oba na głucho. */
        "frame-src 'none'",
        "object-src 'none'",
        /* Formularze wolno wysyłać wyłącznie do nas i pod adres funkcji. */
        `form-action 'self' ${new URL(firma.formularzEndpoint).origin}`,
        /* Nikt nie może osadzić naszej strony w swojej ramce i podstawić pod
           nią własnych przycisków. */
        "base-uri 'self'",
        "upgrade-insecure-requests",
      ].join("; ")}
    />
    {/* Zabezpieczenia przed osadzeniem strony w cudzej ramce TU NIE MA i nie
        da się jej dołożyć. `frame-ancestors` działa wyłącznie w nagłówku HTTP,
        a `X-Frame-Options` w znaczniku przeglądarka jawnie odrzuca — sprawdziłem
        i wypisuje o tym ostrzeżenie w konsoli na każdej podstronie. GitHub Pages
        nie pozwala ustawiać własnych nagłówków, więc jedyną drogą jest zmiana
        gospodarza na takiego, który to potrafi.

        Ryzyko jest realne, ale niewielkie: strona nie ma panelu logowania ani
        żadnej akcji, którą dałoby się wywołać jednym kliknięciem w podstawionym
        miejscu. Najgorsze, co ktoś może zrobić, to pokazać naszą treść w swojej
        ramce — nieprzyjemne, lecz bez szkody dla odwiedzającego. */}
    {/* Przeglądarka nie zgaduje typu pliku wbrew temu, co podał serwer. */}
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    {/* Do obcych serwisów nie wysyłamy pełnego adresu podstrony, z której
        ktoś wyszedł — sama domena wystarczy. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pelnyTytul}</title>
    <meta name="description" content={opis} />
    {/* Strona istnieje pod swoim adresem, ale nie ma jej w nawigacji ani
        w mapie serwisu i prosimy wyszukiwarki o pominięcie. Tak wygląda
        podstrona gotowa, lecz czekająca na dane — można ją obejrzeć
        i pokazać do sprawdzenia, nie publikując. */}
    {bezIndeksowania && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={kanoniczny} />

    <link rel="manifest" href={url("/site.webmanifest")} />
    <meta name="theme-color" content="#1E5FCC" />

    <link rel="icon" href={url("/logo/skills-academy-favicon.svg")} type="image/svg+xml" />
    {/* Zapasowy .ico dla przeglądarek, które i tak pytają o /favicon.ico */}
    <link rel="icon" href={url("/favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />

    <meta property="og:site_name" content={firma.nazwa} />
    <meta property="og:title" content={pelnyTytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:image" content={new URL(url("/logo/skills-academy-udostepnianie.jpg"), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* Opis obrazu dla osób, które w kanale mają wyłączone grafiki albo
        korzystają z czytnika ekranu. */}
    <meta property="og:image:alt" content="Skills Academy — centrum kompetencji w Szczecinie" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(znacznik)} />

    {/* Dane strukturalne pytań i odpowiedzi. Wyszukiwarka potrafi pokazać je
        wprost w wynikach, więc rodzic widzi odpowiedź o cenie i rezygnacji,
        zanim w cokolwiek kliknie. Wymóg: pytanie i odpowiedź muszą stać na
        stronie w widocznej treści, a nie wyłącznie w tym znaczniku — u nas
        pochodzą z tej samej tablicy, więc rozjechać się nie mogą. */}
    {/* Okruszki dla wyszukiwarki. Pokazują w wynikach ścieżkę zamiast samego
        adresu, więc widać, że matura należy do Exams, a nie jest luźną
        podstroną. Wymóg: ta sama ścieżka musi być widoczna na stronie —
        u nas renderuje ją ten sam obiekt, więc rozjechać się nie mogą. */}
    {okruszki && okruszki.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: [
            { nazwa: "Strona główna", href: "/" },
            ...okruszki,
          ].map((o, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: o.nazwa,
            ...(o.href ? { item: new URL(url(o.href), Astro.site).href } : {}),
          })),
        })}
      />
    )}

    {pytania && pytania.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: pytania.map((p) => ({
            "@type": "Question",
            name: p.pytanie,
            acceptedAnswer: { "@type": "Answer", text: p.odpowiedz },
          })),
        })}
      />
    )}
  </head>

  <body class={senior ? "rejestr-senior" : undefined}>
    <a class="pomin-do-tresci" href="#tresc">Przejdź do treści</a>
    {/* Kolejność jest istotna: pasek użytkowy PRZED nagłówkiem i poza nim.
        Nagłówek jest przyklejony do góry okna — pasek w jego wnętrzu
        przykleiłby się razem z nim i zabierał wysokość na każdym ekranie. */}
    <PasekUzytkowy />
    <Naglowek aktywna={aktywna} ctaSenior={senior} />
    <main id="tresc">
      <slot />
    </main>
    <Stopka />
    <NaGore />
    <ZgodaCookies />
    <PasekAkcji senior={senior} />
  </body>
</html>
