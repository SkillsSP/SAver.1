---
import Baza from "../layouts/Baza.astro";
import DoUzupelnienia from "../components/DoUzupelnienia.astro";
import {
  url,
  firma,
  telefonHref,
  telefonTekst,
  emailTekst,
  adresTekst,
  grupyWiekowe,
} from "../lib/site.js";

const tel = telefonHref();
const endpoint = firma.formularzEndpoint;

const poWyslaniu = [
  "Oddzwaniamy i pytamy o kilka rzeczy o dziecku.",
  "Proponujemy grupę i termin zajęć próbnych.",
  "Dziecko bierze udział w pełnym spotkaniu, Wy patrzycie z boku. Potem rozmawiamy — bez presji.",
];
---

<Baza
  aktywna="zapisy"
  tytul="Zapisy na zajęcia próbne"
  opis="Umówcie bezpłatne zajęcia próbne w Skills Academy w Szczecinie. Jedno pełne spotkanie w grupie, bez zobowiązań."
>
  <section class="naglowek-strony">
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Zapisy</span>
        <h1 class="tytul-1">Umówcie bezpłatne zajęcia próbne</h1>
        <p class="hero__zdanie">
          Zostawcie kontakt, a my odezwiemy się i wspólnie wybierzemy termin. Zajęcia próbne nie zobowiązują do zapisu.
        </p>
      </div>
    </div>
  </section>

  <section class="sekcja">
    <div class="szerokosc">
      <div class="siatka--boczna">
        {/* FORMULARZ — cztery pola, telefon obowiązkowy */}
        <div class="stos">
          <div class="naglowek-sekcji" style="margin-bottom: 0;">
            <h2 class="tytul-2">Formularz zgłoszenia</h2>
            <p class="tekst-maly tekst-drugi">
              Cztery pola. Oddzwaniamy — to najszybsza droga do ustalenia terminu.
            </p>
          </div>

          <form
            class="formularz"
            method="post"
            action={endpoint ?? undefined}
            data-telefon={tel ?? ""}
            data-telefon-tekst={tel ? telefonTekst() : ""}
          >
            {/* Rodzaj rozstrzyga po stronie serwera, jak potraktować
                zgłoszenie i na który adres je skierować. */}
            <input type="hidden" name="rodzaj" value="zapis" />

            <div class="pole">
              <label for="dziecko">Imię dziecka</label>
              <input
                type="text"
                id="dziecko"
                name="imie_dziecka"
                autocomplete="off"
                required
              />
            </div>

            <div class="pole">
              <label for="wiek">Wiek dziecka</label>
              <select id="wiek" name="wiek_dziecka" required>
                <option value="">Wybierzcie…</option>
                {grupyWiekowe.map((g) => (
                  <option value={g.lata}>{g.lata} lat</option>
                ))}
              </select>
            </div>

            <div class="pole">
              <label for="telefon">
                Telefon
                <span class="pole__wskazowka">Oddzwaniamy, żeby ustalić termin.</span>
              </label>
              <input
                type="tel"
                id="telefon"
                name="telefon"
                autocomplete="tel"
                inputmode="tel"
                required
              />
            </div>

            <div class="pole">
              <label for="email">
                E-mail
                <span class="pole__wskazowka">Opcjonalnie — jeśli wolicie kontakt pisemny.</span>
              </label>
              <input type="email" id="email" name="email" autocomplete="email" />
            </div>

            <div class="zgoda">
              <input type="checkbox" id="zgoda" name="zgoda" required />
              <label for="zgoda">
                Wyrażam zgodę na kontakt w sprawie zajęć próbnych i przetwarzanie
                podanych danych. Szczegóły w
                <a href={url("/klauzula-rodo")}>klauzuli informacyjnej</a> i
                <a href={url("/polityka-prywatnosci")}>polityce prywatności</a>.
              </label>
            </div>

            {/* Pułapka na roboty. Ukryta przed człowiekiem i przed czytnikiem
                ekranu, bez atrybutu required — wypełni ją tylko automat. */}
            <div class="pulapka" aria-hidden="true">
              <label for="firma_www">Adres strony firmy</label>
              <input type="text" id="firma_www" name="firma_www" tabindex="-1" autocomplete="off" />
            </div>

            {endpoint ? (
              <button type="submit" class="przycisk przycisk--akcja przycisk--pelny">
                Wyślij zgłoszenie
              </button>
            ) : (
              /* Bez adresu odbiorczego przycisk zostaje wyłączony. Formularz,
                 który po kliknięciu przeładowuje stronę i gubi wpisane dane,
                 jest gorszy od formularza, który uczciwie mówi, że nie działa. */
              <>
                <button
                  type="submit"
                  class="przycisk przycisk--akcja przycisk--pelny"
                  disabled
                  aria-describedby="formularz-nieczynny"
                >
                  Wyślij zgłoszenie
                </button>
                <p class="komunikat-formularza" id="formularz-nieczynny">
                  Formularz nie jest jeszcze podłączony do skrzynki.
                  {tel ? (
                    <> Prosimy o telefon: <a href={tel}>{telefonTekst()}</a>.</>
                  ) : (
                    <> Prosimy o kontakt na <a href={`mailto:${firma.email}`}>{firma.email}</a>.</>
                  )}
                </p>
              </>
            )}

            {/* Komunikat po wysłaniu. `aria-live` sprawia, że czytnik ekranu
                przeczyta go od razu, bez przenoszenia fokusu. */}
            <p class="komunikat-formularza" data-status hidden aria-live="polite"></p>

            <noscript>
              <p class="komunikat-formularza">
                Wysyłka formularza wymaga włączonego JavaScriptu.
                {tel ? (
                  <> Bez niego prosimy o telefon: <a href={tel}>{telefonTekst()}</a>.</>
                ) : (
                  <> Bez niego prosimy o kontakt telefoniczny.</>
                )}
              </p>
            </noscript>
          </form>

          <DoUzupelnienia czego="Podłączenie skrzynki">
            Formularz wysyła zgłoszenie do funkcji <code>/api/zapis</code>, która
            przepisuje je na skrzynkę i niczego nie zapisuje. Żeby ruszyła,
            w panelu Cloudflare trzeba dodać dwie wartości:
            <code>RESEND_API_KEY</code> jako sekret i <code>MAIL_DO</code>
            z adresem odbiorcy. Do tego czasu rodzic dostaje komunikat, że
            formularz czeka na podłączenie — nie błąd i nie ciszę. Po ustawieniu
            wyślijcie jedno prawdziwe zgłoszenie i sprawdźcie, czy doszło.
          </DoUzupelnienia>
        </div>

        {/* KONTAKT BEZPOŚREDNI */}
        <div class="stos">
          <div class="karta karta--luzna">
            <h2 class="tytul-3">Kontakt bezpośredni</h2>
            <ul class="lista-rozdzielona">
              <li>
                <span class="etykieta">Telefon</span>
                <span class="wartosc">
                  {tel ? <a class="link-w-zdaniu" href={tel}>{telefonTekst()}</a> : telefonTekst()}
                </span>
              </li>
              <li>
                <span class="etykieta">E-mail</span>
                <span class="wartosc">
                  {firma.email ? (
                    <a class="link-w-zdaniu" href={`mailto:${firma.email}`}>{emailTekst()}</a>
                  ) : (
                    emailTekst()
                  )}
                </span>
              </li>
              <li>
                <span class="etykieta">Adres</span>
                <span class="wartosc">{adresTekst()}</span>
              </li>
              <li>
                <span class="etykieta">Biuro czynne</span>
                <span class="wartosc">{firma.godzinyBiura ?? "godziny w uzupełnieniu"}</span>
              </li>
            </ul>
          </div>

          <div class="miejsce-na-zdjecie">
            <strong>Mapa dojazdu</strong>
            Pojawi się tu po ustaleniu adresu lokalu. Bez adresu, telefonu i mapy
            nie da się też uruchomić wizytówki Google — a to główne źródło ruchu
            dla centrum w jednym mieście.
          </div>

          <div class="karta">
            <h3 class="tytul-4">Bezpieczeństwo dziecka</h3>
            <p class="tekst-maly tekst-drugi">
              Zanim zapiszecie dziecko, warto przeczytać, kto u nas pracuje
              z dziećmi i na jakich zasadach.
            </p>
            <a class="link-w-zdaniu" href={url("/bezpieczenstwo")}>
              Standardy Ochrony Małoletnich
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CO SIĘ DZIEJE PO WYSŁANIU */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Dalej</span>
          <h2 class="tytul-1">Co się dzieje po zgłoszeniu</h2>
        </div>
        <ol class="kroki">
          {poWyslaniu.map((tresc) => (
            <li class="kroki__krok">
              <div class="kroki__tresc">
                <p style="font-size: var(--text-bazowy); color: var(--tekst-glowny);">{tresc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Baza>

<script>
  /* Wysyłka zgłoszenia bez przeładowania strony.

     Formularz ma poprawny `action` i `method`, więc gdyby ten skrypt się nie
     wykonał, przeglądarka wysłałaby go klasycznie — funkcja przyjmuje oba
     formaty. Skrypt służy tylko temu, żeby rodzic zobaczył odpowiedź na
     miejscu, zamiast trafiać na surową odpowiedź serwera. */
  const formularz = document.querySelector(".formularz");
  const status = formularz?.querySelector("[data-status]");

  if (formularz && status) {
    const przycisk = formularz.querySelector('button[type="submit"]');
    const napisPrzycisku = przycisk?.textContent ?? "";
    const tel = formularz.dataset.telefon;
    const telTekst = formularz.dataset.telefonTekst;

    /** Dokleja prośbę o telefon, o ile numer jest już znany. */
    function zProsbaOTelefon(tresc) {
      status.textContent = tresc;
      if (!tel) return;
      status.append(" Prosimy o telefon: ");
      const odnosnik = document.createElement("a");
      odnosnik.href = tel;
      odnosnik.textContent = telTekst;
      status.append(odnosnik, ".");
    }

    function pokaz(rodzaj) {
      status.hidden = false;
      status.dataset.rodzaj = rodzaj;
    }

    formularz.addEventListener("submit", async (zdarzenie) => {
      if (!formularz.reportValidity()) return;
      zdarzenie.preventDefault();

      przycisk.disabled = true;
      przycisk.textContent = "Wysyłamy…";
      status.hidden = true;
      status.textContent = "";

      try {
        const odpowiedz = await fetch(formularz.action, {
          method: "POST",
          headers: { accept: "application/json" },
          body: new FormData(formularz),
        });
        const tresc = await odpowiedz.json().catch(() => ({}));

        if (odpowiedz.ok) {
          status.textContent =
            "Dziękujemy. Zgłoszenie do nas dotarło — odezwiemy się telefonicznie.";
          pokaz("sukces");
          formularz.reset();
          /* Zdarzenie leci do analityki tylko wtedy, gdy odwiedzający zgodził
             się na ciasteczka — bramkę trzyma window.saTrack. */
          window.saTrack?.("zapis_formularz");
          return;
        }

        zProsbaOTelefon(
          tresc.blad || "Nie udało się wysłać zgłoszenia."
        );
        pokaz("blad");
      } catch {
        zProsbaOTelefon("Brak połączenia z siecią — zgłoszenie nie wyszło.");
        pokaz("blad");
      } finally {
        przycisk.disabled = false;
        przycisk.textContent = napisPrzycisku;
      }
    });
  }
</script>
