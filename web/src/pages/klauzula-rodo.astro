---

<StronaPrawna
  tytul="Klauzula informacyjna RODO"
  opis="Informacja o przetwarzaniu danych osobowych rodzica i dziecka w Skills Academy: administrator, cele, podstawy prawne, okres przechowywania i prawa."
  wstep="Klauzula informacyjna dla rodziców i opiekunów zapisujących dziecko na zajęcia. Dokument jest w wersji roboczej — podstawy prawne musi przypisać prawnik."
  sekcje={sekcje}
/>
