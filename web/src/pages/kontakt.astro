---
import Baza from "../layouts/Baza.astro";
import Spolecznosciowe from "../components/Spolecznosciowe.astro";
import DoUzupelnienia from "../components/DoUzupelnienia.astro";
import FotoNaglowka from "../components/FotoNaglowka.astro";
import {
  url,
  firma,
  telefonHref,
  telefonTekst,
  emailTekst,
  adresTekst,
  ochronaMaloletnich,
} from "../lib/site.js";

/* ==========================================================================
   KONTAKT

   Do sierpnia 2026 pozycja „Kontakt” stała w pasku nawigacji, ale prowadziła
   do zakotwiczenia w stopce, a wszystkie przyciski kontaktowe na formularz
   zapisu. Zapisy obsługują jedną intencję — „chcę umówić zajęcia próbne”.
   Ta strona obsługuje cztery pozostałe: pytanie o ofertę, prośbę o rozmowę bez
   zapisu, sprawę formalną i zgłoszenie ze standardów ochrony małoletnich.

   Czwarta ścieżka jest wymagana ustawowo i nie może kończyć się formularzem
   zapisowym ani prowadzić przez osoby prowadzące zajęcia.

   LOKAL. Adres jest i stoi w zdaniu „gdzie jesteśmy”, przy telefonie
   i adresie e-mail, czyli tam, gdzie rodzic go szuka. NADAL ZDJĘTE zostają
   rzeczy, których nie mamy: karta „przyjdźcie do biura” z godzinami otwarcia,
   opis dojazdu i parkingu, mapa oraz godziny w nagłówku. Wracają razem
   z danymi, a nie razem z adresem — pusty nawias w miejscu godzin wygląda jak
   błąd wdrożenia, a brak sekcji nie wygląda na nic.
   ========================================================================== */

const tel = telefonHref();
const endpoint = firma.formularzEndpoint;

/* Wybór tematu zmienia dwie rzeczy: podpowiedź pod polem i przykład w polu
   treści. Trzyma je jedna tablica, żeby nie rozjechały się przy edycji. */
const tematy = [
  {
    id: "oferta",
    etykieta: "Pytanie o zajęcia, termin albo cenę",
    podpowiedz:
      "Odpowiadamy w ciągu jednego dnia roboczego.",
    przyklad: "np. Córka ma 9 lat, szukamy zajęć w środy po 16:00.",
  },
  {
    id: "rozmowa",
    etykieta: "Prośba o rozmowę — bez zapisu",
    podpowiedz:
      "Oddzwonimy w dogodnej porze. Nie namawiamy na zapis w trakcie tej rozmowy.",
    przyklad:
      "np. Proszę o telefon po 17:00, chcę najpierw dopytać o metodę.",
  },
  {
    id: "formalna",
    etykieta: "Sprawa formalna: faktura, rezygnacja, dane",
    podpowiedz:
      "Sprawy formalne prowadzi biuro, nie osoba prowadząca zajęcia.",
    przyklad: "np. Proszę o fakturę za wrzesień na dane firmy.",
  },
  {
    id: "ochrona",
    etykieta: "Zgłoszenie ze standardów ochrony małoletnich",
    podpowiedz: `Zgłoszenie kierujemy do osoby odpowiedzialnej — ${ochronaMaloletnich.imie}. Dane kontaktowe są w karcie obok, możecie też napisać wprost do niej.`,
    przyklad:
      "Opiszcie sytuację własnymi słowami — data i miejsce pomagają, ale nie są warunkiem.",
  },
];

/* Cztery pozycje, siatka 2×2. Puste pola zostają jako `null`, a nie jako
   nawias w treści — komponent noty redakcyjnej mówi, czego brakuje. */
const daneFirmy = [
  { etykieta: "Nazwa", wartosc: firma.nazwa },
  { etykieta: "NIP", wartosc: firma.nip },
  { etykieta: "REGON", wartosc: firma.regon ?? null },
  /* Etykieta skrócona z „Administrator danych": pełny termin łamał wiersz na
     najwęższych telefonach, a w tej sekcji nie ma innych administratorów.
     Pełne brzmienie stoi w klauzuli RODO, gdzie ma znaczenie prawne. */
  { etykieta: "Administrator", wartosc: firma.administratorDanych ?? null },
];
---

<Baza
  aktywna="kontakt"
  tytul="Kontakt"
  opis="Telefon, e-mail i formularz kontaktowy Skills Academy w Szczecinie. Osobna ścieżka zgłoszeń ze standardów ochrony małoletnich."
>
  <section class="naglowek-strony naglowek-strony--foto" style="--foto-kadr: center 45%">
    <FotoNaglowka nazwa="motion-3" />
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Kontakt</span>
        <h1 class="tytul-1">Napiszcie albo zadzwońcie</h1>
        <p class="hero__zdanie">
          Odpowiadamy w ciągu jednego dnia roboczego. Jeśli chcecie od razu
          umówić bezpłatne zajęcia próbne,{" "}
          <a href={url("/zapisy")}>przejdźcie do zapisów</a> — tam formularz
          pyta o dziecko, a nie o sprawę.
        </p>
      </div>
    </div>
  </section>

  {/* TRZY DROGI KONTAKTU. Czwarta — „przyjdźcie do biura” — czeka nie na
      adres, tylko na godziny, w których pod tym adresem ktoś jest. Karta
      zapraszająca do biura bez godzin otwarcia wysyła rodzica pod zamknięte
      drzwi. */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="siatka siatka--troje">
        <a class="droga-kontaktu" href={tel ?? "#formularz"}>
          <span class="droga-kontaktu__etykieta">Telefon</span>
          <span class="droga-kontaktu__wartosc droga-kontaktu__wartosc--telefon">
            {telefonTekst()}
          </span>
          <span class="droga-kontaktu__opis">
            Najszybsza droga. Jeśli nie odbieramy, jesteśmy na zajęciach —
            oddzwonimy tego samego dnia.
          </span>
        </a>

        <a class="droga-kontaktu" href={`mailto:${firma.email}`}>
          <span class="droga-kontaktu__etykieta">E-mail</span>
          <span class="droga-kontaktu__wartosc">{emailTekst()}</span>
          <span class="droga-kontaktu__opis">
            Dobre na sprawy formalne i na wszystko, co wymaga załącznika.
          </span>
        </a>

        <a class="droga-kontaktu" href="#formularz">
          <span class="droga-kontaktu__etykieta">Formularz</span>
          <span class="droga-kontaktu__wartosc">Napiszcie do nas</span>
          <span class="droga-kontaktu__opis">
            Wybieracie temat, my kierujemy sprawę do właściwej osoby.
          </span>
        </a>
      </div>

      {/* PROFIL SPOŁECZNOŚCIOWY POD DROGAMI KONTAKTU, a nie jako czwarta karta.

          Siatka wyżej ma trzy kolumny i czwarta karta rozbiłaby ją na 3+1 —
          ten sam problem sierotki, który stoi opisany przy progach cennika
          i przy zespole. Poza tym profil nie jest równorzędną drogą kontaktu:
          rodzic, który chce się umówić, ma zadzwonić albo wypełnić formularz.
          Facebook jest dla tych, którzy chcą najpierw popatrzeć.

          Komponent nie wypisuje niczego, dopóki żaden profil nie ma adresu,
          więc ta sekcja zniknie sama, gdyby adresy kiedyś zniknęły. */}
      <div style="margin-top: var(--space-4);">
        <Spolecznosciowe tytul="Jesteśmy też tutaj" />
      </div>

      {/* GDZIE JESTEŚMY — tuż pod drogami kontaktu, a nie na końcu strony.

          Wcześniej ta karta stała w kolumnie obok formularza. Na komputerze
          wyglądało to sensownie, bo obie kolumny widać naraz. Na telefonie
          kolumna boczna zjeżdża POD formularz, więc pytanie „gdzie właściwie
          jesteście" znajdowało odpowiedź dopiero 2700 px w dół, za formularzem
          kontaktowym i kartą zgłoszeń. Zmierzone, nie oszacowane.

          Rodzic, który sprawdza, czy centrum jest po jego stronie miasta,
          zadaje to pytanie ZANIM cokolwiek napisze. Odpowiedź stoi teraz przy
          telefonie i adresie e-mail, czyli tam, gdzie jej szuka. */}
      {/* Zdanie ma dwie wersje, bo od adresu zależy, co jest tu prawdą.
          Bez adresu obiecywaliśmy podać go przez telefon; z adresem ta sama
          obietnica brzmiałaby jak wykręt przy wypisanej ulicy. Przełącza się
          samo po wpisaniu `firma.ulica` w site.js. */}
      <p class="gdzie-jestesmy" id="dojazd">
        <strong>Gdzie jesteśmy:</strong>{" "}
        {firma.ulica ? (
          <>
            {adresTekst()} — zajęcia prowadzimy stacjonarnie. O dojazd
            i najbliższy parking zapytajcie przez telefon, powiemy od razu.
          </>
        ) : (
          <>
            zajęcia prowadzimy stacjonarnie w {firma.miastoWMiejscowniku}.
            Dokładny adres i dojazd podajemy przez telefon — zadzwońcie,
            powiemy od razu.
          </>
        )}
      </p>
    </div>
  </section>

  {/* FORMULARZ + KARTA ZGŁOSZEŃ

      TŁO. Sekcja miała klasę `sekcja--karta`, czyli białe tło — a karty w jej
      środku też są białe. Efekt był taki, że trzy różne bloki (formularz,
      zgłoszenie dotyczące dziecka, dojazd) czytały się jako jedna biała płaszczyzna
      bez granic. Sekcja idzie teraz na delikatny kobalt, więc białe karty
      odcinają się od tła i widać, gdzie kończy się jedna sprawa, a zaczyna druga. */}
  <section class="sekcja sekcja--tint" id="formularz">
    <div class="szerokosc">
      <div class="siatka--boczna">
        <div class="stos">
          <div class="naglowek-sekcji" style="margin-bottom: 0;">
            <h2 class="tytul-2">Formularz kontaktowy</h2>
            <p class="tekst-maly tekst-drugi">
              Zacznijcie od tematu — reszta pól dopasuje się do sprawy.
            </p>
          </div>

          {/* `data-clarity-mask` wymusza zamaskowanie CAŁEGO formularza
              w nagraniach sesji Microsoft Clarity — niezależnie od ustawień
              w ich panelu. Clarity domyślnie maskuje pola tekstowe, ale przy
              stronie, na której rodzic wpisuje imię i wiek dziecka, nie
              polegamy na ustawieniu u dostawcy: nagranie nie może zawierać
              tych danych nawet przez pomyłkę w konfiguracji. */}
          <form
            class="formularz"
            method="post"
            action={endpoint ?? undefined}
            data-clarity-mask="true"
            data-telefon={tel ?? ""}
            data-telefon-tekst={tel ? telefonTekst() : ""}
          >
            {/* Rodzaj formularza rozstrzyga po stronie serwera, na który adres
                trafi zgłoszenie. Bez tego pola funkcja nie odróżniłaby sprawy
                formalnej od zgłoszenia ze standardów. */}
            <input type="hidden" name="rodzaj" value="kontakt" />

            <div class="pole">
              <label for="temat">W jakiej sprawie</label>
              <select id="temat" name="temat" required data-temat>
                {tematy.map((t) => (
                  <option value={t.id} data-podpowiedz={t.podpowiedz} data-przyklad={t.przyklad}>
                    {t.etykieta}
                  </option>
                ))}
              </select>
              <span class="pole__wskazowka" data-podpowiedz-tematu>
                {tematy[0].podpowiedz}
              </span>
            </div>

            <div class="pole">
              <label for="imie">Imię i nazwisko</label>
              <input type="text" id="imie" name="imie" autocomplete="name" required />
            </div>

            <div class="pole">
              <label for="telefon">
                Telefon{" "}
                <span class="pole__wskazowka">Wystarczy jedno: telefon albo e-mail.</span>
              </label>
              <input type="tel" id="telefon" name="telefon" autocomplete="tel" inputmode="tel" />
            </div>

            <div class="pole">
              <label for="email">E-mail</label>
              <input type="email" id="email" name="email" autocomplete="email" />
            </div>

            <div class="pole">
              <label for="wiadomosc">Treść wiadomości</label>
              <textarea
                id="wiadomosc"
                name="tresc"
                rows="5"
                required
                placeholder={tematy[0].przyklad}
                data-tresc
              ></textarea>
            </div>

            <div class="zgoda">
              <input type="checkbox" id="zgoda" name="zgoda" required />
              <label for="zgoda">
                Wyrażam zgodę na kontakt w sprawie zgłoszenia i przetwarzanie
                podanych danych. Szczegóły w{" "}
                <a href={url("/klauzula-rodo")}>klauzuli informacyjnej</a> i{" "}
                <a href={url("/polityka-prywatnosci")}>polityce prywatności</a>.
              </label>
            </div>

            {/* Pułapka na roboty. Nie ukrywamy jej przez `display: none` ani
                `visibility: hidden` — nowsze automaty to wykrywają i pomijają.
                Nazwa musi wyglądać wiarygodnie, stąd „firma_www”, a nie „bot”. */}
            <div class="pulapka" aria-hidden="true">
              <label for="firma_www">Adres strony firmy</label>
              <input type="text" id="firma_www" name="firma_www" tabindex="-1" autocomplete="off" />
            </div>

            {/* Znacznik czasu otwarcia formularza. Wypełnienie poniżej trzech
                sekund nie jest pracą ręczną. Wartość wpisuje skrypt, żeby nie
                pochodziła z pamięci podręcznej strony. */}
            <input type="hidden" name="otwarto" value="" data-otwarto />

            {endpoint ? (
              <button type="submit" class="przycisk przycisk--akcja przycisk--pelny">
                Wyślij wiadomość
              </button>
            ) : (
              <>
                <button
                  type="submit"
                  class="przycisk przycisk--akcja przycisk--pelny"
                  disabled
                  aria-describedby="formularz-nieczynny"
                >
                  Wyślij wiadomość
                </button>
                <p class="komunikat-formularza" id="formularz-nieczynny">
                  Formularz nie jest jeszcze podłączony do skrzynki.
                  {tel ? (
                    <> Prosimy o telefon: <a href={tel}>{telefonTekst()}</a>.</>
                  ) : (
                    <> Prosimy o kontakt na <a href={`mailto:${firma.email}`}>{firma.email}</a>.</>
                  )}
                </p>
              </>
            )}

            <p class="komunikat-formularza" data-status hidden aria-live="polite"></p>

            <noscript>
              <p class="komunikat-formularza">
                Formularz zadziała także bez JavaScriptu — po wysłaniu
                zobaczycie potwierdzenie na osobnej stronie.
                {tel ? (
                  <> Wolicie od razu porozmawiać? <a href={tel}>{telefonTekst()}</a>.</>
                ) : (
                  <> Wolicie od razu porozmawiać? Zadzwońcie do nas.</>
                )}
              </p>
            </noscript>
          </form>
        </div>

        {/* KARTY OBOK */}
        <div class="stos">
          <article class="karta karta--luzna">
            <span class="plakietka plakietka--kobalt">Ochrona małoletnich</span>
            <h2 class="tytul-3">Zgłoszenie dotyczące dziecka</h2>
            <p class="tekst-maly tekst-drugi">
              Za standardy ochrony małoletnich odpowiada{" "}
              <strong>{ochronaMaloletnich.imie}</strong>. Zgłoszenie można
              złożyć anonimowo — przez formularz obok, wybierając ten temat,
              albo wprost na adres poniżej.
            </p>
            <ul class="lista-rozdzielona">
              <li>
                <span class="etykieta">E-mail</span>
                <span class="wartosc">
                  <a class="link-w-zdaniu" href={`mailto:${ochronaMaloletnich.email}`}>
                    {ochronaMaloletnich.email}
                  </a>
                </span>
              </li>
              <li>
                <span class="etykieta">Telefon</span>
                <span class="wartosc">
                  {ochronaMaloletnich.telefon ?? telefonTekst()}
                </span>
              </li>
            </ul>
            <p class="tekst-drobny">
              <a class="link-w-zdaniu" href={url("/bezpieczenstwo")}>
                Pełne standardy ochrony małoletnich
              </a>
            </p>
          </article>

          {!ochronaMaloletnich.adresBezposredni && (
            <DoUzupelnienia czego="Osobny adres do zgłoszeń">
              Adres i numer prowadzą na razie do skrzynki i telefonu centrum.
              Ustawa wymaga ścieżki omijającej biuro oraz osoby prowadzące
              zajęcia — zgłoszenie może dotyczyć kogoś z zespołu, więc wspólna
              skrzynka czyni ją pozorną. Do założenia: adres wyłącznie dla osoby
              odpowiedzialnej i jej numer bezpośredni.
            </DoUzupelnienia>
          )}

        </div>
      </div>
    </div>
  </section>

  {/* DANE FIRMY */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Dane</span>
        <h2 class="tytul-1">Dane firmy</h2>
        <p class="wiodacy">
          Te same dane figurują w regulaminie, polityce prywatności i klauzuli
          informacyjnej. Jedno brzmienie, cztery miejsca.
        </p>
      </div>

      {/* JEDEN KAFELEK ZAMIAST CZTERECH KART.

          Wcześniej każda dana rejestrowa miała własną kartę w siatce. Cztery
          krótkie fakty — nazwa, NIP, REGON, administrator — zajmowały przez to
          na telefonie cztery pełne wiersze, jeden pod drugim, każdy z osobnym
          obramowaniem i wypełnieniem. Dane rejestrowe nie są treścią, do której
          się wraca; rodzic sprawdza je raz albo wcale, a przy sporze i tak
          znajdzie je w regulaminie.

          Lista rozdzielona daje ten sam komplet w jednym kafelku: etykieta
          z lewej, wartość z prawej, włos między wierszami. Ten sam wzorzec
          stoi w „Zanim zapytacie" na stronie głównej i przy zgłoszeniach na
          stronie bezpieczeństwa, więc oko już go zna. */}
      <article class="karta dane-firmy">
        <ul class="lista-rozdzielona">
          {/* Pokazujemy wyłącznie pozycje, które mamy — bez wiersza „do
              uzupełnienia" i bez zdania pod listą zapowiadającego resztę.
              To jest miejsce, w którym rodzic sprawdza, czy ma do czynienia
              z zarejestrowanym podmiotem: widzi tu dane, które są, i nic
              o tych, których jeszcze nie ma. */}
          {daneFirmy.filter((d) => d.wartosc).map((d) => (
            <li>
              <span class="etykieta">{d.etykieta}</span>
              <span class="wartosc">{d.wartosc}</span>
            </li>
          ))}
        </ul>
      </article>

      <div style="margin-top: var(--space-3); max-width: var(--szerokosc-tekstu);">
        <DoUzupelnienia czego="Dane rejestrowe">
          Do wpisania NIP, REGON i nazwa administratora danych. Muszą brzmieć
          identycznie w czterech miejscach: tutaj, w regulaminie, w polityce
          prywatności i w klauzuli RODO. Rozjazd między nimi jest pierwszą
          rzeczą, którą wychwytuje kontrola.
        </DoUzupelnienia>
      </div>
    </div>
  </section>
</Baza>

<script>
  /* ------------------------------------------------------------------
     Wybór tematu przestawia podpowiedź i przykład w polu treści.
     ------------------------------------------------------------------ */
  const wybor = document.querySelector("[data-temat]");
  const podpowiedz = document.querySelector("[data-podpowiedz-tematu]");
  const tresc = document.querySelector("[data-tresc]");

  if (wybor && podpowiedz && tresc) {
    const odswiez = () => {
      const opcja = wybor.options[wybor.selectedIndex];
      podpowiedz.textContent = opcja.dataset.podpowiedz ?? "";
      tresc.placeholder = opcja.dataset.przyklad ?? "";
    };
    wybor.addEventListener("change", odswiez);
    odswiez();
  }

  /* ------------------------------------------------------------------
     Znacznik czasu otwarcia. Wpisujemy go skryptem, a nie w kodzie strony,
     bo strona jest statyczna i wartość wpisana przy budowaniu byłaby
     godzinami stara dla każdego odwiedzającego.
     ------------------------------------------------------------------ */
  const otwarto = document.querySelector("[data-otwarto]");
  if (otwarto) otwarto.value = String(Date.now());

  /* ------------------------------------------------------------------
     Wysyłka bez przeładowania strony.
     ------------------------------------------------------------------ */
  const formularz = document.querySelector(".formularz");
  const status = formularz?.querySelector("[data-status]");

  if (formularz && status && formularz.getAttribute("action")) {
    const przycisk = formularz.querySelector('button[type="submit"]');
    const napis = przycisk?.textContent ?? "";
    const tel = formularz.dataset.telefon;
    const telTekst = formularz.dataset.telefonTekst;

    function zProsbaOTelefon(t) {
      status.textContent = t;
      if (!tel) return;
      status.append(" Prosimy o telefon: ");
      const a = document.createElement("a");
      a.href = tel;
      a.textContent = telTekst;
      status.append(a, ".");
    }

    formularz.addEventListener("submit", async (zdarzenie) => {
      /* Telefon i e-mail są osobno opcjonalne, ale przynajmniej jedno musi
         być wypełnione. Przeglądarka tego nie wyrazi atrybutem `required`,
         więc sprawdzamy ręcznie — a serwer powtarza tę kontrolę u siebie. */
      const telefon = formularz.telefon.value.trim();
      const email = formularz.email.value.trim();
      if (!telefon && !email) {
        zdarzenie.preventDefault();
        formularz.telefon.setCustomValidity("Wystarczy jedno z dwóch: telefon albo e-mail.");
        formularz.telefon.reportValidity();
        return;
      }
      formularz.telefon.setCustomValidity("");

      if (!formularz.reportValidity()) return;
      zdarzenie.preventDefault();

      przycisk.disabled = true;
      przycisk.textContent = "Wysyłamy…";
      status.hidden = true;
      status.textContent = "";

      try {
        const odp = await fetch(formularz.action, {
          method: "POST",
          headers: { accept: "application/json" },
          body: new FormData(formularz),
        });
        const dane = await odp.json().catch(() => ({}));

        if (odp.ok) {
          status.textContent =
            "Dziękujemy. Wiadomość do nas dotarła — odpowiemy w ciągu jednego dnia roboczego.";
          status.dataset.rodzaj = "sukces";
          status.hidden = false;
          formularz.reset();
          if (otwarto) otwarto.value = String(Date.now());
          const o = wybor?.options[wybor.selectedIndex];
          if (podpowiedz && o) podpowiedz.textContent = o.dataset.podpowiedz ?? "";
          window.saTrack?.("wiadomosc_formularz");
          return;
        }

        zProsbaOTelefon(dane.blad || "Nie udało się wysłać wiadomości.");
        status.dataset.rodzaj = "blad";
        status.hidden = false;
      } catch {
        zProsbaOTelefon("Brak połączenia z siecią — wiadomość nie wyszła.");
        status.dataset.rodzaj = "blad";
        status.hidden = false;
      } finally {
        przycisk.disabled = false;
        przycisk.textContent = napis;
      }
    });
  }
</script>
