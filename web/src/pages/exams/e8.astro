---
import Baza from "../../layouts/Baza.astro";
import OdeslanieDoGrup from "../../components/OdeslanieDoGrup.astro";
import DoUzupelnienia from "../../components/DoUzupelnienia.astro";
import ZapisCta from "../../components/ZapisCta.astro";
import { url } from "../../lib/site.js";
---

{/*
  Trzynastolatek to nadal Teens Junior — paleta główna, ton rówieśniczy,
  Fredoka w nagłówkach. Slate byłby tu błędem, niezależnie od przedmiotu.
*/}
<Baza
  aktywna="exams"
  tytul="Egzamin ósmoklasisty — angielski i matematyka"
  opis="Przygotowanie do egzaminu ósmoklasisty z angielskiego i z matematyki w Szczecinie. Arkusze CKE, strategie zadań, oswojenie z formatem testu."
>
  <section class="naglowek-strony">
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Exams · klasy 7–8</span>
        <h1 class="tytul-1">Egzamin ósmoklasisty</h1>
        <p class="hero__zdanie">
          Dwa przedmioty, jeden schemat pracy: arkusz na wejściu, plan wstecz od
          daty egzaminu, próby kontrolne z wynikiem punktowym. Bez zgadywania,
          na czym stoicie.
        </p>
        <ul class="naglowek-strony__meta">
          <li>Klasy 7–8</li>
          <li>Start przygotowań — termin w uzupełnieniu</li>
        </ul>
        <div class="przyciski" style="margin-top: var(--space-2);">
          <a class="przycisk przycisk--duch" href="#angielski">Angielski</a>
          <a class="przycisk przycisk--duch" href="#matematyka">
            Matematyka <span class="plakietka unikat">Unikat</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ANGIELSKI */}
  <section class="sekcja" id="angielski">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Przedmiot</span>
          <h2 class="tytul-1">Angielski</h2>
          <p class="plakietka plakietka--kobalt" style="justify-self: start;">Poziom A2+</p>
        </div>
        <div class="stos">
          <p class="wiodacy">
            Pełny zakres arkusza: rozumienie ze słuchu, znajomość środków
            językowych, wypowiedź pisemna. Pracujemy na arkuszach CKE z ostatnich
            lat, w warunkach zbliżonych do egzaminacyjnych.
          </p>
          <ul class="lista-znaczona">
            <li>Grupa albo zajęcia 1:1 — do wyboru</li>
            <li>Regularne spotkania w stałym terminie</li>
            <li>Próbny arkusz w cyklu ustalonym na starcie</li>
            <li>Strategie zadań zamkniętych i krótkiej wypowiedzi pisemnej</li>
          </ul>
          <p class="tekst-maly">
            <a class="link-w-zdaniu" href={url("/indywidualne")}>Wolicie 1:1?</a>
            Zajęcia indywidualne obejmują też przygotowanie egzaminacyjne.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* MATEMATYKA — wyróżnik */}
  <section class="sekcja sekcja--karta sekcja--wlos" id="matematyka">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Przedmiot</span>
          <h2 class="tytul-1">
            Matematyka <span class="plakietka unikat">Unikat</span>
          </h2>
        </div>
        <div class="stos">
          <p class="wiodacy">
            Jedyny przedmiot poza angielskim w naszej ofercie. Prowadzimy go, bo
            matematyka najczęściej decyduje o wyniku rekrutacji, a dobrego
            wsparcia w Szczecinie brakuje.
          </p>
          <ul class="lista-znaczona">
            <li>Diagnoza braków przed pierwszym spotkaniem</li>
            <li>Grupa albo zajęcia 1:1 — do wyboru</li>
            <li>Plan rozpisany wstecz od terminu egzaminu</li>
          </ul>
          <DoUzupelnienia czego="Matematyka — konkrety">
            Do wpisania: zakres materiału, liczebność grupy, długość
            i częstotliwość spotkania. Osobno — nazwisko prowadzącej wraz
            z wykształceniem i doświadczeniem egzaminacyjnym oraz odesłanie do
            „O nas”. To nazwisko, a nie plakietka, zamienia „unikat” w konkret.
          </DoUzupelnienia>
        </div>
      </div>
    </div>
  </section>

  <section class="sekcja">
    <div class="szerokosc">
      <OdeslanieDoGrup />
    </div>
  </section>

  <ZapisCta
    tytul="Zacznijcie od arkusza, nie od deklaracji"
    tresc="Konsultacja z arkuszem diagnostycznym pokazuje, ile punktów realnie brakuje i ile spotkań potrzeba do celu. Stawki znajdziecie w cenniku."
    przycisk="Zapisz się na konsultację"
  />
</Baza>
