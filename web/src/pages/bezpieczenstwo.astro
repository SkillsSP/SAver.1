---
import Baza from "../layouts/Baza.astro";
import DoUzupelnienia from "../components/DoUzupelnienia.astro";
import {
  url,
  wielkoscGrupyTekst,
  firma,
  telefonHref,
  telefonTekst,
  ochronaMaloletnich,
  ubezpieczenie,
} from "../lib/site.js";
import FotoNaglowka from "../components/FotoNaglowka.astro";

const tel = telefonHref();

const odbior = [
  {
    tytul: "Wejście",
    opis: "Rodzic przekazuje dziecko prowadzącemu przy sali. Obecność zapisujemy na liście.",
  },
  {
    tytul: "Odbiór",
    opis: "Osoba nieznana prowadzącemu okazuje dokument. Bez upoważnienia dziecka nie wydajemy i dzwonimy do rodzica.",
  },
  {
    tytul: "Samodzielne wyjście",
    opis: "Możliwe tylko na pisemną zgodę rodzica, od wieku ustalonego w regulaminie.",
  },
  {
    tytul: "Spóźniony odbiór",
    opis: "Dziecko czeka pod opieką pracownika. Kontaktujemy się kolejno z osobami z listy.",
  },
];

const zgloszenie = [
  {
    tytul: "Przyjęcie zgłoszenia tego samego dnia",
    opis: `Zgłoszenie przyjmuje ${ochronaMaloletnich.imie}, osoba odpowiedzialna za standardy. W razie jej nieobecności zastępuje ją ${ochronaMaloletnich.zastepca}. Do skrzynki, na którą przychodzą zgłoszenia, mają dostęp wyłącznie te dwie osoby — nikt inny z centrum jej nie czyta.`,
  },
  {
    tytul: "Zabezpieczenie dziecka",
    opis: "Jeśli podejrzenie dotyczy osoby z centrum, odsuwamy ją od kontaktu z dziećmi na czas wyjaśniania. Nie czekamy na rozstrzygnięcie.",
  },
  {
    tytul: "Powiadomienie rodzica i służb",
    opis: "Informujemy rodziców, chyba że są osobami podejrzewanymi. Przy podejrzeniu przestępstwa zawiadamiamy policję lub prokuraturę, a przy zagrożeniu dobra dziecka — sąd rodzinny.",
  },
  {
    tytul: "Wsparcie i wnioski",
    opis: "Ustalamy z rodzicem plan wsparcia dziecka. Po zakończeniu sprawy sprawdzamy, co w naszych procedurach zawiodło, i zapisujemy zmianę.",
  },
];

/* Numery ogólnopolskie, bezpłatne i czynne całą dobę. Podajemy je obok własnych
   danych kontaktowych, bo dziecko musi mieć drogę zgłoszenia niezależną od
   centrum — także wtedy, gdy podejrzenie dotyczy osoby stąd. */
/* Numery zapisane ze spacjami NIEROZDZIELAJĄCYMI. Numer alarmowy złamany
   na dwa wiersze — „800 12" na końcu jednego, „12 12" na początku drugiego —
   jest w chwili, w której ktoś go potrzebuje, nieczytelny. Wykrył to walidator
   kodu HTML; własne sprawdzenia tego nie obejmowały. */
const telefonyZaufania = [
  {
    nazwa: "Telefon zaufania dla dzieci i młodzieży",
    numer: "116 111",
    opis: "Bezpłatny, czynny całą dobę",
  },
  {
    nazwa: "Rzecznik Praw Dziecka",
    numer: "800 12 12 12",
    opis: "Bezpłatny, czynny całą dobę",
  },
];

const dokumenty = [
  "Standardy Ochrony Małoletnich",
  "Zgoda na wykorzystanie wizerunku",
  "Upoważnienie do odbioru dziecka",
];

/* Wersja dla dziecka — ustawa wymaga jej obok wersji pełnej. Zdania krótkie,
   w drugiej osobie, bez terminów prawnych. */
const zasadyDlaDziecka = [
  "Nikt nie ma prawa Cię krzywdzić. Ani dziecko, ani dorosły.",
  "Jeśli coś Ci się nie podoba, możesz powiedzieć STOP.",
  "Nie musisz się przytulać ani dawać ręki, jeśli nie chcesz.",
  "Nie robimy Ci zdjęć, jeśli Ty albo Twoi rodzice tego nie chcecie.",
  "Możesz powiedzieć o wszystkim każdej osobie, która tu pracuje.",
  "Kiedy powiesz, że ktoś Cię skrzywdził, uwierzymy Ci i pomożemy.",
];
---

<Baza
  aktywna="o-nas"
  tytul="Standardy Ochrony Małoletnich"
  opis="Standardy Ochrony Małoletnich w Skills Academy w Szczecinie: weryfikacja osób pracujących z dziećmi, zasady kontaktu, procedura zgłoszeń i telefony zaufania."
>
  <section class="naglowek-strony naglowek-strony--foto" style="--foto-kadr: center 40%">
    <FotoNaglowka nazwa="life-bezpieczenstwo" />
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Bezpieczeństwo</span>
        <h1 class="tytul-1">Standardy Ochrony Małoletnich</h1>
        <p class="hero__zdanie">
          Publikujemy nasze standardy w całości, bo rodzic ma prawo wiedzieć, kto
          pracuje z jego dzieckiem, na jakich zasadach i co się stanie, jeśli coś
          pójdzie nie tak. Ten dokument obowiązuje każdą osobę w centrum —
          prowadzących, biuro, osoby współpracujące.
        </p>
      </div>
    </div>
  </section>

  {/* Kadr domyka lukę, przez którą ta strona wyglądała jak dokument prawny,
      a nie jak część programu: bezpieczeństwo jest u nas także tematem zajęć,
      nie tylko procedurą w regulaminie. */}
  <section class="sekcja sekcja--bez-gory">
    <div class="szerokosc">
      <figure class="kafel">
        <img
          class="kafel__kadr"
          src={url("/foto/life-strazak-800.webp")}
          srcset={`${url("/foto/life-strazak-800.webp")} 800w, ${url("/foto/life-strazak-1200.webp")} 1200w, ${url("/foto/life-strazak-1600.webp")} 1600w`}
          sizes="(min-width: 68rem) 24rem, 100vw"
          alt="Dzieci w strojach strażackich podczas zajęć o bezpieczeństwie"
          loading="lazy"
          decoding="async"
          style="height: clamp(11rem, 20vw, 15.5rem)"
        />
        <figcaption class="kafel__podpis">
          Bezpieczeństwo ćwiczymy na zajęciach, nie tylko opisujemy w regulaminie.
          Zdjęcie ilustracyjne.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="sekcja sekcja--tint">
    <div class="szerokosc">
      <DoUzupelnienia czego="Przegląd prawny">
        Ustawa wymaga opublikowania dwóch wersji standardów jednocześnie: pełnej
        i skróconej, napisanej językiem zrozumiałym dla dziecka. Obie są poniżej.
        Przed publikacją treść musi przejść przegląd prawny, a Wy musicie
        uzupełnić: numer i datę wersji dokumentu, datę następnego przeglądu,
        wiek samodzielnego wyjścia, liczbę dni na usunięcie
        materiałów po wycofaniu zgody wizerunkowej, częstotliwość przeglądu
        apteczek oraz adres e-mail do zgłoszeń.
      </DoUzupelnienia>
    </div>
  </section>

  {/* WERSJA DLA RODZICA */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Wersja pełna</span>
        <h2 class="tytul-1">Dla rodzica i opiekuna</h2>
      </div>

      <div class="stos stos--luzny">
        <div class="siatka--wiodaca">
          <h3 class="tytul-3">Kto może pracować z dziećmi</h3>
          <div class="stos stos--ciasny">
            <p class="tekst-drugi">
              Każdą osobę przed dopuszczeniem do zajęć sprawdzamy w Rejestrze
              Sprawców Przestępstw na Tle Seksualnym. Bez tego nikt nie wchodzi
              do sali — dotyczy to również osób zastępujących i praktykantów.
            </p>
            <ul class="lista-znaczona lista-odhaczona">
              <li>Zaświadczenie o niekaralności z Krajowego Rejestru Karnego</li>
              <li>Oświadczenie o państwach zamieszkania z ostatnich 20 lat</li>
              <li>Potwierdzone kwalifikacje do pracy z dziećmi</li>
              <li>Podpisane zobowiązanie do przestrzegania tych standardów</li>
            </ul>
          </div>
        </div>

        <div class="siatka--wiodaca">
          <h3 class="tytul-3">Zasady bezpiecznego kontaktu</h3>
          <div class="stos stos--ciasny">
            <p class="tekst-drugi">
              Dorosły nigdy nie zostaje z dzieckiem sam za zamkniętymi drzwiami.
              Zajęcia indywidualne prowadzimy w salach z przeszkleniem albo przy
              otwartych drzwiach.
            </p>
            <ul class="lista-znaczona">
              <li>Bez kontaktu prywatnego prowadzącego z dzieckiem — komunikacja idzie przez rodzica i kanały centrum</li>
              <li>Bez przewożenia dzieci prywatnym samochodem</li>
              <li>Zakaz kar fizycznych, krzyku, wyśmiewania i komentarzy o wyglądzie</li>
              <li>Dziecko ma prawo odmówić kontaktu fizycznego, także pomocy przy ubieraniu</li>
            </ul>
          </div>
        </div>

        <div class="siatka--wiodaca">
          <h3 class="tytul-3">Przyprowadzanie i odbiór dziecka</h3>
          <div class="stos stos--ciasny">
            <p class="tekst-drugi">
              Dziecko wydajemy wyłącznie osobom wskazanym na piśmie przez rodzica
              lub opiekuna prawnego. Listę osób upoważnionych rodzic wypełnia przy
              zapisie i może ją zmienić w każdej chwili.
            </p>
            <ol class="kroki">
              {odbior.map((krok) => (
                <li class="kroki__krok">
                  <div class="kroki__tresc">
                    <strong>{krok.tytul}</strong>
                    <p>{krok.opis}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="siatka--wiodaca">
          <h3 class="tytul-3">Wizerunek dziecka</h3>
          <div class="stos stos--ciasny">
            <p class="tekst-drugi">
              Bez pisemnej zgody rodzica nie publikujemy żadnego zdjęcia ani
              nagrania. Zgodę można wycofać w każdej chwili, bez podawania powodu
              — usuwamy wtedy materiał z naszych kanałów w terminie ustalonym
              w zgodzie.
            </p>
            <ul class="lista-znaczona">
              <li>Nigdy nie podpisujemy zdjęć imieniem i nazwiskiem dziecka</li>
              <li>Nie oznaczamy lokalizacji przy zdjęciach z dziećmi</li>
              <li>Zdjęcia robi wyłącznie osoba wyznaczona, sprzętem centrum</li>
              <li>Odmowa zgody nie wpływa na udział dziecka w zajęciach</li>
            </ul>
          </div>
        </div>

        <div class="siatka--wiodaca">
          <h3 class="tytul-3">Sala, grupa, zdrowie</h3>
          <div class="stos stos--ciasny">
            <p class="tekst-drugi">
              Grupy liczą {wielkoscGrupyTekst} osób, żeby prowadzący widział każde
              dziecko. Informacje o alergiach i chorobach przewlekłych zbieramy
              przy zapisie i przekazujemy tylko osobom prowadzącym zajęcia.
            </p>
            <ul class="lista-znaczona">
              <li>Apteczka w każdej sali, z regularnym przeglądem</li>
              <li>Osoba z aktualnym kursem pierwszej pomocy na każdej zmianie</li>
              <li>Przy urazie dzwonimy do rodzica natychmiast, przed spisaniem notatki</li>
              <li>Dziecko z gorączką lub objawami infekcji nie zostaje na zajęciach</li>
            </ul>
          </div>
        </div>

        <div class="siatka--wiodaca">
          <h3 class="tytul-3">Co się dzieje, kiedy ktoś zgłosi krzywdzenie</h3>
          <div class="stos stos--ciasny">
            <p class="tekst-drugi">
              Zgłoszenie może złożyć każdy — dziecko, rodzic, pracownik, osoba
              postronna. Nie oceniamy, czy podejrzenie jest wystarczająco poważne.
              Każde uruchamia tę samą procedurę.
            </p>
            <ol class="kroki">
              {zgloszenie.map((krok) => (
                <li class="kroki__krok">
                  <div class="kroki__tresc">
                    <strong>{krok.tytul}</strong>
                    <p>{krok.opis}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* GDZIE ZGŁOSIĆ */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Zgłoszenia</span>
        <h2 class="tytul-1">Gdzie zgłosić</h2>
        <p class="wiodacy">
          Zgłoszenie można złożyć anonimowo. Jeśli zostawicie kontakt,
          odpowiadamy w ciągu jednego dnia roboczego.
        </p>
      </div>

      <div class="siatka siatka--troje">
        {/* STAN NA DZIŚ: adresu bezpośredniego NIE MA. Zgłoszenia idą na wspólny
            `kontakt@skilful.pl`, do którego dostęp mają dwie osoby — Karolina
            i Natalia, czyli osoba odpowiedzialna za standardy i jej zastępczyni.

            To jest słabość i trzeba ją nazwać po imieniu: zgłoszenie dotyczące
            jednej z nich trafia do skrzynki, którą ta osoba czyta. Dlatego
            `ochronaMaloletnich.adresBezposredni` stoi na `false`, a zdanie
            niżej NIE obiecuje, że zgłoszenie omija biuro — mówi zamiast tego
            o anonimowości i o numerach niezależnych od centrum, które stoją
            w sąsiednich kartach. Tamta droga jest tu prawdziwym zabezpieczeniem,
            nie ozdobnikiem.

            Po założeniu osobnej skrzynki czytanej przez jedną osobę wpiszcie
            ją w `ochronaMaloletnich.email` i przestawcie `adresBezposredni`
            na `true` — zdanie zmieni się samo. */}
        <article class="karta karta--luzna">
          <span class="plakietka plakietka--kobalt">W centrum</span>
          <h3 class="tytul-4">Do osoby odpowiedzialnej</h3>
          <p class="tekst-maly tekst-drugi">
            Za standardy ochrony małoletnich odpowiada{" "}
            <strong>{ochronaMaloletnich.imie}</strong>, a w czasie jej
            nieobecności zastępuje ją <strong>{ochronaMaloletnich.zastepca}</strong>.
            {ochronaMaloletnich.adresBezposredni
              ? " Zgłoszenie trafia wprost do niej — nie przez biuro i nie przez osoby prowadzące zajęcia."
              : " Zgłoszenie można też złożyć anonimowo albo skorzystać z numerów niezależnych od centrum, wymienionych obok."}
          </p>
          <ul class="lista-rozdzielona">
            <li>
              <span class="etykieta">E-mail</span>
              <span class="wartosc">
                <a class="link-w-zdaniu" href={`mailto:${ochronaMaloletnich.email}`}>
                  {ochronaMaloletnich.email}
                </a>
              </span>
            </li>
            <li>
              <span class="etykieta">Telefon</span>
              <span class="wartosc">
                {ochronaMaloletnich.telefon
                  ? ochronaMaloletnich.telefon
                  : tel
                    ? <a class="link-w-zdaniu" href={tel}>{telefonTekst()}</a>
                    : telefonTekst()}
              </span>
            </li>
          </ul>
        </article>

        {telefonyZaufania.map((t) => (
          <article class="karta karta--luzna">
            <span class="plakietka plakietka--koral">Niezależnie od centrum</span>
            <h3 class="tytul-4">{t.nazwa}</h3>
            <p class="numer-alarmowy">
              <a href={`tel:${t.numer.replace(/\s/g, "")}`}>{t.numer}</a>
            </p>
            <p class="tekst-drobny">{t.opis}</p>
          </article>
        ))}
      </div>

      <p class="tekst-maly tekst-drugi" style="margin-top: var(--space-4); max-width: var(--szerokosc-tekstu);">
        Numery ogólnopolskie podajemy celowo obok własnych. Dziecko musi mieć
        drogę zgłoszenia niezależną od centrum — także wtedy, gdy podejrzenie
        dotyczy kogoś stąd.
      </p>
    </div>
  </section>

  {/* DOKUMENTY */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Dokumenty</span>
          <h2 class="tytul-1">Do wglądu i pobrania</h2>
          <p class="tekst-drugi tekst-maly">
            Papierowy egzemplarz jest zawsze dostępny w biurze.
          </p>
        </div>
        <div class="stos">
          <ul class="lista-rozdzielona">
            {dokumenty.map((d) => (
              <li>
                <span class="etykieta">{d}</span>
                <span class="wartosc">wydajemy przy zapisach</span>
              </li>
            ))}
          </ul>
          <DoUzupelnienia czego="Pliki do pobrania">
            Po przeglądzie prawnym wgrajcie trzy pliki PDF do{" "}
            <code>web/public/dokumenty/</code> i podmieńcie w tej sekcji
            zastępniki na odnośniki. Do czasu wgrania stoi tam „wydajemy przy
            zapisach" — zdanie prawdziwe i po Waszej stronie, a nie informacja
            o tym, czego jeszcze nie ma.
          </DoUzupelnienia>
        </div>
      </div>
    </div>
  </section>

  {/* UBEZPIECZENIE. Rodzice o to pytają, a mało która placówka pisze o tym
       na stronie. Dopóki polisy nie ma, zdanie stoi w czasie przyszłym;
       przestawienie `ubezpieczenie.wykupione` w site.js zamienia je na fakt.

       TERMIN Z TEGO ZDANIA ZNIKNĄŁ 2 września 2026. Stało tam „wykupimy przed
       pierwszymi zajęciami — to warunek uruchomienia naboru". Zajęcia ruszyły,
       polisy nie ma, więc zdanie z zobowiązania zamieniło się w nieprawdę
       o nas samych. Zostaje samo zobowiązanie, bez terminu, którego nie
       dotrzymaliśmy.

       Zdania o tym, czego NIE MA, tu nie ma i mieć nie powinno — ale skrót
       w drugą stronę byłby zwykłą nieprawdą w miejscu, w którym rodzic pyta
       o bezpieczeństwo dziecka. Zobowiązanie w czasie przyszłym mówi to samo,
       nie ogłaszając braku i nie kłamiąc. */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Ubezpieczenie</span>
          <h2 class="tytul-1">
            {ubezpieczenie.wykupione ? "Placówka jest ubezpieczona" : "Odpowiedzialność cywilna placówki"}
          </h2>
        </div>
        <div class="stos">
          {ubezpieczenie.wykupione ? (
            <p class="wiodacy">
              Centrum ma wykupioną polisę odpowiedzialności cywilnej,
              obejmującą zajęcia prowadzone w naszej siedzibie. Zakres ochrony
              pokazujemy do wglądu na życzenie, przed podpisaniem umowy.
            </p>
          ) : (
            <>
              <p class="wiodacy">
                Polisę odpowiedzialności cywilnej placówki zawrzemy na cały rok
                szkolny.
              </p>
              <p class="tekst-drugi">
                Zakres ochrony pokażemy do wglądu, gdy tylko dokument będzie
                wystawiony.
              </p>
            </>
          )}
          <p class="tekst-drobny">
            Ubezpieczenie następstw nieszczęśliwych wypadków dziecka pozostaje
            po stronie rodziców — najczęściej pokrywa je polisa szkolna.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* WERSJA DLA DZIECKA — wymagana ustawą, osobnym językiem */}
  <section class="sekcja sekcja--tint">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Wersja skrócona</span>
        <h2 class="tytul-1">Twoje zasady w Skills Academy</h2>
        <p class="wiodacy">Te zasady obowiązują wszystkich, także dorosłych.</p>
      </div>

      <div class="siatka siatka--2">
        <article class="karta karta--luzna">
          <ul class="lista-znaczona">
            {zasadyDlaDziecka.map((z) => <li>{z}</li>)}
          </ul>
        </article>

        <article class="karta karta--luzna">
          <h3 class="tytul-3">Możesz też zadzwonić</h3>
          <p class="tekst-drugi tekst-maly">
            Możesz porozmawiać z kimś spoza centrum. To nic nie kosztuje.
          </p>
          <p class="numer-alarmowy">
            <a href="tel:116111">116 111</a>
          </p>
          <p class="tekst-drobny">
            Telefon Zaufania dla Dzieci i Młodzieży, czynny przez całą dobę
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="sekcja">
    <div class="szerokosc">
