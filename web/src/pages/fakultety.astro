---
import Baza from "../layouts/Baza.astro";
import OdeslanieDoGrup from "../components/OdeslanieDoGrup.astro";
import DoUzupelnienia from "../components/DoUzupelnienia.astro";
import ZapisCta from "../components/ZapisCta.astro";
import { url, fakultety } from "../lib/site.js";
import FotoNaglowka from "../components/FotoNaglowka.astro";

const wybor = [
  {
    tytul: "Spotkanie otwarte",
    opis: "Na początku semestru dziecko może zajrzeć na każdy fakultet po kolei.",
  },
  {
    tytul: "Wybór",
    opis:
      "Dziecko wybiera jeden. Drugi i trzeci są możliwe; liczą się wtedy jako kolejne programy.",
  },
  {
    tytul: "Pokaz na koniec",
    opis: "Każdy fakultet kończy semestr czymś, co da się pokazać rodzicom.",
  },
];
---

<Baza
  aktywna="program"
  tytul="Fakultety — Music, Art, Acting i Motion Skills"
  opis="Music, Art, Acting i Motion Skills. Jedna dziedzina, którą dziecko wybiera samo — jako dodatek do zajęć podstawowych albo samodzielnie. Skills Academy w Szczecinie."
>
  <section class="naglowek-strony naglowek-strony--foto" style="--foto-kadr: center 40%">
    <FotoNaglowka nazwa="life-przyjaciele" />
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Program</span>
        <h1 class="tytul-1">Jedna dziedzina, którą dziecko wybiera samo</h1>
        <p class="hero__zdanie">
          Fakultet możecie dołożyć do zajęć podstawowych albo wziąć samodzielnie
          — cena zależy od liczby programów, nie od tego, które wybierzecie.
          Prowadzimy go po angielsku, ale język schodzi tu na drugi plan. Liczy
          się to, co dziecko robi.
        </p>
      </div>
    </div>
  </section>

  {/* CZTERY FAKULTETY — cztery karty na jednej stronie, nie cztery podstrony */}
  <section class="sekcja">
    <div class="szerokosc">
      {/* Cztery karty ze zdjęciem — wariant szerszy, bo kadr potrzebuje
          miejsca. Wcześniej stała tu siatka dwuelementowa o minimum 320 px,
          przez co od 1152 px wchodziła trzecia kolumna i czwarta karta
          zostawała sama pod spodem. */}
      <div class="siatka siatka--czworo-foto">
        {fakultety.map((f) => (
          <article class="karta karta--luzna karta--ze-zdjeciem">
            <img
              class="kafel__kadr zdjecie--w-karcie"
              src={url(`/foto/${f.zdjecie}-800.webp`)}
              srcset={`${url(`/foto/${f.zdjecie}-800.webp`)} 800w, ${url(`/foto/${f.zdjecie}-1600.webp`)} 1600w`}
              sizes="(min-width: 68rem) 32rem, 100vw"
              alt={f.zdjecieAlt}
              loading="lazy"
              decoding="async"
            />
            <h2 class="tytul-3">{f.nazwa}</h2>
            <p class="tekst-drugi tekst-maly">{f.wiodace}</p>
            <p class="tekst-drobny">
              Prowadzi <strong>{f.prowadzi}</strong> · jeden program, od 200 zł miesięcznie
            </p>
          </article>
        ))}
      </div>

      <p class="nota-ilustracyjna">
        Zdjęcia ilustracyjne — po starcie zastępujemy je materiałem z własnych
        zajęć.
      </p>

      <div style="margin-top: var(--space-4); max-width: var(--szerokosc-tekstu);">
        <DoUzupelnienia czego="Zakres i terminy fakultetów">
          Nazwiska prowadzących i cena już są. Do wpisania zostaje zakres,
          materiały i wiek uczestników oraz dzień i godzina zajęć — rodzic
          wybierający fakultet porównuje właśnie te trzy rzeczy.
        </DoUzupelnienia>
      </div>
    </div>
  </section>

  {/* JAK WYBRAĆ */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Wybór</span>
          <h2 class="tytul-1">Jak wybrać fakultet</h2>
          <p class="tekst-drugi tekst-maly">
            Dziecko wybiera, nie rodzic. Jeśli po kilku spotkaniach okaże się, że
            trafiło źle, zmieniamy fakultet bez dopłaty.
          </p>
        </div>
        <ol class="kroki">
          {wybor.map((krok) => (
            <li class="kroki__krok">
              <div class="kroki__tresc">
                <strong>{krok.tytul}</strong>
                <p>{krok.opis}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* ZASADY ORGANIZACYJNE */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="siatka siatka--2">
        <div class="stos">
          <h2 class="tytul-3">Zasady organizacyjne</h2>
          <ul class="lista-znaczona">
            <li>Fakultet liczy się jako jeden program, więc można go wziąć bez zajęć podstawowych</li>
            <li>Grupa rusza przy pięciu zapisanych osobach, górna granica to osiem</li>
            <li>Materiały i sprzęt zapewnia centrum</li>
            <li>
              Drugi i trzeci fakultet to kolejne programy w tej samej cenie
              progowej, <a class="link-w-zdaniu" href={url("/cennik")}>zobaczcie cennik</a>
            </li>
          </ul>
        </div>
        <DoUzupelnienia czego="Organizacja">
          Do wpisania: długość i częstotliwość spotkania, termin graniczny
          bezpłatnej zmiany fakultetu oraz kwalifikacje prowadzących. Nazwiska
          już są — Acting i Motion prowadzi Karolina Dumała, Music i Art
          Natalia Marczewska.
        </DoUzupelnienia>
      </div>
    </div>
  </section>

  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <OdeslanieDoGrup />
    </div>
  </section>

  <ZapisCta
    tytul="Nie wiecie, który fakultet? Niech dziecko sprawdzi wszystkie"
    tresc="Spotkania otwarte na początku semestru są bezpłatne, także dla osób spoza centrum."
    przycisk="Zapytaj o wolne miejsca"
  />
</Baza>
