---
import Baza from "../layouts/Baza.astro";
import KotwicaCeny from "../components/KotwicaCeny.astro";
import OdeslanieDoGrup from "../components/OdeslanieDoGrup.astro";
import DoUzupelnienia from "../components/DoUzupelnienia.astro";
import ZapisCta from "../components/ZapisCta.astro";
import { url, wielkoscGrupyTekst, cenyOd} from "../lib/site.js";
import FotoNaglowka from "../components/FotoNaglowka.astro";

const przebieg = [
  {
    tytul: "Rozgrzewka",
    opis: "Ruch i krótka wymiana zdań. Angielski włącza się, zanim ktokolwiek usiądzie.",
  },
  {
    tytul: "Misja",
    opis: "Zadanie z jasnym celem i ograniczeniem czasu. Dzieci pracują w drużynach.",
  },
  {
    tytul: "Pokaz",
    opis: "Każda drużyna pokazuje wynik reszcie grupy. Krótko, po angielsku.",
  },
  {
    tytul: "Domknięcie",
    opis:
      "Co zadziałało, co nie. Prowadzący zbiera obserwacje i omówi je z Wami na konsultacji.",
  },
];

/* Sześć obszarów Life Skills. Podpis obrazu opisuje kadr, tytuł nazywa
   kompetencję — to dwie różne rzeczy i nie mogą się powielać, bo czytnik
   ekranu przeczytałby wtedy to samo dwa razy. */
const lifeSkills = [
  {
    plik: "life-pierwsza-pomoc",
    podpis: "Dzieci ćwiczą pierwszą pomoc na fantomach",
    tytul: "Pierwsza pomoc",
    zdanie: "Ćwiczenie na fantomie, schemat postępowania, numer alarmowy.",
  },
  {
    plik: "life-bezpieczenstwo",
    podpis: "Policjant tłumaczy dzieciom zasady przechodzenia przez jezdnię",
    tytul: "Bezpieczeństwo w mieście",
    zdanie: "Droga do domu, obcy dorosły, ruch drogowy.",
  },
  {
    plik: "life-warsztat",
    podpis: "Dziecko pracuje przy warsztacie stolarskim",
    tytul: "Praca ręczna",
    zdanie: "Narzędzia, miara, dokończony przedmiot na koniec misji.",
  },
  {
    plik: "cooking-2",
    podpis: "Dzieci przygotowują posiłek przy wspólnym stole",
    tytul: "Kuchnia i samodzielność",
    zdanie: "Przepis po angielsku, podział zadań, posiłek do zjedzenia razem.",
  },
  {
    plik: "life-wolontariat",
    podpis: "Dzieci segregują dary podczas zbiórki",
    tytul: "Empatia i pomaganie",
    zdanie: "Zbiórka, rozmowa o potrzebach innych, konkretne działanie.",
  },
  {
    plik: "life-globus",
    podpis: "Dzieci pochylone nad globusem",
    tytul: "Świat i źródła",
    zdanie: "Skąd wiem, że to prawda — fakt, opinia, źródło.",
  },
];
---

<Baza
  aktywna="program"
  tytul="Zajęcia podstawowe — Useful Skills i Life Skills"
  opis="Dwa filary jednego spotkania: angielski w działaniu i kompetencje życiowe. Baza każdego karnetu w Skills Academy w Szczecinie, grupy do ośmiu osób."
>
  <section class="naglowek-strony naglowek-strony--foto" style="--foto-kadr: center 50%">
    <FotoNaglowka nazwa="life-robotyka" />
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Program</span>
        <h1 class="tytul-1">Zajęcia podstawowe</h1>
        <p class="hero__zdanie">
          Dwa filary, jedno spotkanie. Dziecko używa angielskiego, żeby coś zrobić
          — a przy okazji ćwiczy współpracę, wystąpienia i myślenie krytyczne.
          Fakultety i Exams dokładacie osobno.
        </p>
        <KotwicaCeny od={cenyOd.programy} jednostka="miesięcznie" />
        <ul class="naglowek-strony__meta">
          <li>Wiek 5–15 lat</li>
          <li>Grupa {wielkoscGrupyTekst} osób</li>
          <li>Obie ścieżki obowiązkowe</li>
        </ul>
      </div>
    </div>
  </section>

  {/* DWA FILARY */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="siatka siatka--2">
        <article class="karta karta--luzna">
          <span class="plakietka plakietka--kobalt">Filar I</span>
          <h2 class="tytul-3">Useful Skills</h2>
          <p class="tekst-drugi tekst-maly">
            Angielski w działaniu. Dziecko nie tłumaczy zdań — negocjuje, pyta,
            wyjaśnia i rozwiązuje zadanie, bo inaczej misja się nie uda.
          </p>
          <ul class="lista-znaczona">
            <li>Słownictwo wychodzi z sytuacji na zajęciach</li>
            <li>Mówienie od pierwszego spotkania, także z błędami</li>
            <li>Czytanie i pisanie w służbie zadania</li>
          </ul>
        </article>

        <article class="karta karta--luzna">
          <span class="plakietka plakietka--kobalt">Filar II</span>
          <h2 class="tytul-3">Life Skills</h2>
          <p class="tekst-drugi tekst-maly">
            Kompetencje, których szkoła nie zdąży nauczyć. Ćwiczone na tym samym
            materiale, w tej samej grupie, bez osobnej lekcji „o wartościach”.
          </p>
          <ul class="lista-znaczona">
            <li>Praca w drużynie i dzielenie się rolą</li>
            <li>Wystąpienie przed grupą — krótkie, konkretne</li>
            <li>Ocena źródeł i odróżnianie faktu od opinii</li>
          </ul>
        </article>
      </div>

      <p class="tekst-maly tekst-drugi" style="margin-top: var(--space-3); max-width: var(--szerokosc-tekstu);">
        Exams — przygotowanie do egzaminu ósmoklasisty i matury — stoi{" "}
        <strong>poza</strong> zajęciami podstawowymi. To osobna oferta,
        kupowana obok, na tych samych zasadach dla uczestnika zajęć i dla kogoś
        z zewnątrz. <a class="link-w-zdaniu" href={url("/exams")}>Zobaczcie Exams</a>.
      </p>
    </div>
  </section>

  {/* LIFE SKILLS W PRAKTYCE. Sześć kart zamiast listy — Life Skills brzmią
       abstrakcyjnie, dopóki nie widać, co dziecko faktycznie robi. */}
  <section class="sekcja sekcja--tint">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Filar II w praktyce</span>
        <h2 class="tytul-1">Life Skills — co dziecko robi naprawdę</h2>
        <p class="wiodacy">
          Kompetencje życiowe ćwiczymy na tym samym materiale i w tej samej
          grupie, bez osobnej lekcji „o wartościach”.
        </p>
      </div>

      <div class="siatka siatka--wiele">
        {lifeSkills.map((k) => (
          <article class="karta karta--ze-zdjeciem">
            <img
              class="kafel__kadr zdjecie--w-karcie"
              src={url(`/foto/${k.plik}-800.webp`)}
              srcset={`${url(`/foto/${k.plik}-800.webp`)} 800w, ${url(`/foto/${k.plik}-1200.webp`)} 1200w, ${url(`/foto/${k.plik}-1600.webp`)} 1600w`}
              sizes="(min-width: 68rem) 16rem, (min-width: 40rem) 33vw, 100vw"
              alt={k.podpis}
              loading="lazy"
              decoding="async"
            />
            <h3 class="tytul-4">{k.tytul}</h3>
            <p class="tekst-maly tekst-drugi">{k.zdanie}</p>
          </article>
        ))}
      </div>

      <p class="nota-ilustracyjna">
        Zdjęcia ilustracyjne — zastępujemy je stopniowo materiałem z własnych
        zajęć.
      </p>
    </div>
  </section>

  {/* PRZEBIEG SPOTKANIA */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Rytm</span>
          <h2 class="tytul-1">Jak wygląda jedno spotkanie</h2>
          <p class="tekst-drugi tekst-maly">
            Ta sama struktura na każdych zajęciach. Dziecko wie, czego się
            spodziewać, więc energia idzie w zadanie, nie w orientowanie się
            w sytuacji.
          </p>
        </div>
        <ol class="kroki">
          {przebieg.map((krok) => (
            <li class="kroki__krok">
              <div class="kroki__tresc">
                <strong>{krok.tytul}</strong>
                <p>{krok.opis}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* CZEGO NIE MA / CO DOSTAJE RODZIC */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="siatka siatka--2">
        <div class="stos">
          <h2 class="tytul-3">Czego u nas nie ma</h2>
          <ul class="lista-znaczona lista-przeczaca">
            <li>Kartkówek ze słówek i ocen w skali 1–6</li>
            <li>Prac domowych na każde spotkanie</li>
            <li>Podręcznika, przez który przechodzimy strona po stronie</li>
            <li>Grup, w których jedno dziecko mówi, a dziesięcioro słucha</li>
          </ul>
        </div>
        <div class="stos">
          <h2 class="tytul-3">Co dostaje rodzic</h2>
          <ul class="lista-znaczona lista-odhaczona">
            <li>Konsultację z prowadzącym z omówieniem postępów dziecka</li>
            <li>Informację o nieobecności tego samego dnia</li>
            <li>Zaproszenie na pokaz otwarty</li>
          </ul>
          <DoUzupelnienia czego="Częstotliwość">
            Ustalcie, jak często odbywa się pokaz otwarty, i wpiszcie to wprost
            do punktu powyżej. „Zaproszenie na pokaz” bez częstotliwości brzmi
            jak obietnica, „pokaz na koniec każdego semestru” brzmi jak
            zobowiązanie.
          </DoUzupelnienia>
        </div>
      </div>
    </div>
  </section>


  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <OdeslanieDoGrup />
    </div>
  </section>

  <ZapisCta
    tytul="Przyjdźcie na jedną misję i zobaczcie, jak dziecko reaguje"
    tresc="Zajęcia próbne są bezpłatne i niczego nie przesądzają. Stawki znajdziecie w cenniku."
  />
</Baza>
