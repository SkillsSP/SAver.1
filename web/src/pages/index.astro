---
import Baza from "../layouts/Baza.astro";
import DoUzupelnienia from "../components/DoUzupelnienia.astro";
import {
  url,
  grupyWiekowe,
  zrodla,
  wielkoscGrupyTekst,
  telefonHref,
  telefonTekst,
  firma,
  rokSzkolny,
  ubezpieczenie,
  terminarz,
  grupaMin,
  grupaMax,
} from "../lib/site.js";
import FotoNaglowka from "../components/FotoNaglowka.astro";

const tel = telefonHref();
const pokazTerminarz = terminarz.pokazuj && terminarz.dni.length > 0;

/* --------------------------------------------------------------------------
   PYTANIA OGÓLNE

   Dobór jest tu ważniejszy niż liczba. Odpowiadamy wyłącznie na to, co wiemy
   na pewno dziś — wielkość grupy, język zajęć, wiek, przebieg zajęć próbnych,
   sposób rozliczenia, ubezpieczenie, weryfikacja prowadzących. Świadomie NIE
   ma tu pytań o adres, godziny i liczbę wolnych miejsc: odpowiedź, która za
   miesiąc przestanie być prawdziwa, kosztuje więcej niż jej brak, a te dane
   wciąż czekają na umowę na lokal.

   Te same pytania trafiają do danych strukturalnych (FAQPage) przez warstwę
   `Baza`, więc mogą pokazać się w wyniku wyszukiwania rozwinięte. Dlatego
   każda odpowiedź musi bronić się wyjęta z kontekstu strony.
   -------------------------------------------------------------------------- */
const pytania = [
  {
    pytanie: "Od jakiego wieku przyjmujecie dzieci?",
    odpowiedz:
      "Od 5 do 19 lat. Grupy dobieramy według wieku i tego, co dziecko już umie — sam rocznik bywa mylący, dlatego przed zapisem rozmawiamy. Zajęcia próbne odbywają się w grupie, do której dziecko faktycznie trafiłoby na stałe.",
  },
  {
    pytanie: "Ile dzieci jest w grupie?",
    odpowiedz: `Od ${grupaMin} do ${grupaMax}. Dolna granica jest tu równie ważna jak górna: poniżej ${grupaMin} osób nie ma z kim negocjować ani rozwiązywać zadania zespołowo, a na tym stoją zajęcia podstawowe. Jeśli grupa nie zbierze się do ${grupaMin} osób, proponujemy inny termin albo zwracamy wpłatę.`,
  },
  {
    pytanie: "Czy dziecko musi znać angielski, żeby przyjść?",
    odpowiedz:
      "Nie. Zajęcia podstawowe prowadzimy w całości po angielsku, ale są tak zbudowane, żeby dziecko rozumiało z kontekstu, gestu i działania — nie z tłumaczenia. Przez pierwsze tygodnie dziecko może przede wszystkim słuchać i to jest w porządku.",
  },
  {
    pytanie: "Jak wyglądają zajęcia próbne?",
    odpowiedz:
      "Są bezpłatne i nie zobowiązują do niczego. Dziecko bierze udział na normalnych zasadach, w docelowej grupie, a Państwo patrzą z boku. Po zajęciach rozmawiamy o tym, co widzieliśmy. Nie prosimy o decyzję tego samego dnia.",
  },
  {
    pytanie: "Kiedy ruszają zajęcia?",
    odpowiedz: `Start we ${rokSzkolny.startOdmiana}, w roku szkolnym ${rokSzkolny.etykieta}. Rozliczenie obejmuje dziesięć rat miesięcznych, od września do czerwca. Dni i godziny podamy przed uruchomieniem zapisów.`,
  },
  {
    pytanie: "Jak wygląda płatność i czy mogę zrezygnować w trakcie roku?",
    odpowiedz:
      "Przelewem, raz w miesiącu, przez dziesięć miesięcy. Rezygnacja z ważnego powodu jest możliwa w każdej chwili — miesiąc zgłoszenia jest wtedy ostatnim płatnym, pozostałych rat nie naliczamy. Nie pobieramy wpisowego.",
  },
  {
    pytanie: "Czy placówka jest ubezpieczona?",
    odpowiedz: ubezpieczenie.wykupione
      ? `Tak. Mamy wykupioną polisę — ${ubezpieczenie.zakres} — obejmującą zajęcia prowadzone w centrum. Zakres ochrony przedstawiamy na życzenie.`
      : `Polisę — ${ubezpieczenie.zakres} — wykupimy przed pierwszymi zajęciami i napiszemy to tutaj wprost, razem z zakresem ochrony. Dopóki tego nie zrobimy, nie twierdzimy, że placówka jest już ubezpieczona.`,
  },
  {
    pytanie: "Kto prowadzi zajęcia i czy sprawdzacie te osoby?",
    odpowiedz:
      "Każda osoba pracująca z dziećmi jest sprawdzana w Rejestrze Sprawców Przestępstw na Tle Seksualnym oraz przedstawia zaświadczenie z Krajowego Rejestru Karnego i oświadczenie o państwach zamieszkania — zanim wejdzie na pierwsze zajęcia. Wynika to z ustawy, a całą procedurę opisujemy na stronie Bezpieczeństwo.",
  },
  {
    pytanie: "Co, jeśli dziecko opuści zajęcia?",
    odpowiedz:
      "Rata jest stała i nie zależy od liczby spotkań w danym miesiącu. Pojedynczą nieobecność zgłoszoną z wyprzedzeniem odrabiamy w innej grupie tego samego poziomu.",
  },
];

/* Przebieg jednej misji — Detective Mission rozpisana na kroki. Zamiast
   czterech kafli z nazwami misji pokazujemy jedną, od środka. */
const przebiegMisji = [
  {
    czas: "00:00",
    tytul: "Rozgrzewka w ruchu",
    opis: "Polecenia po angielsku wykonywane ciałem, nie tłumaczone. Metoda TPR.",
  },
  {
    czas: "00:08",
    tytul: "Wskazówka",
    opis: "Jedno zdanie po angielsku. Dzieci muszą się dogadać, co znaczy — same.",
  },
  {
    czas: "00:12",
    tytul: "Śledztwo w drużynach",
    opis: "Pytania do prowadzącej wyłącznie po angielsku. Tu dzieje się cała nauka.",
  },
  {
    czas: "00:32",
    tytul: "Rozwiązanie i wnioski",
    opis: "Każda drużyna tłumaczy swój tok rozumowania. Ćwiczenie argumentacji.",
  },
];

/* Osiem obszarów kompetencji. Kolejność jest zamierzona: zaczynamy od tego,
   co najmniej oczywiste w szkole językowej (elektronika), a kończymy na
   pracy ręcznej — po drodze scena, kuchnia, ruch, muzyka, plastyka i rozmowa. */
const kafle = [
  { plik: "life-dron", podpis: "Elektronika i robotyka" },
  { plik: "acting-2", podpis: "Scena i wystąpienia" },
  { plik: "cooking-1", podpis: "Kuchnia i praca w drużynie" },
  { plik: "motion-1", podpis: "Ruch i drużyna" },
  { plik: "music-3", podpis: "Muzyka i głos" },
  { plik: "art-2", podpis: "Rysunek i praca ręczna" },
  { plik: "life-grupa", podpis: "Rozmowa w małej grupie" },
  { plik: "life-warsztat", podpis: "Narzędzia i własny przedmiot" },
];

const trzyKroki = [
  {
    numer: "01",
    tytul: "Rozmowa i dobór grupy",
    opis:
      "Pytamy o wiek, o to, co dziecko już umie i czego się boi. Czasem powiemy, że lepiej zadziała inna ścieżka niż ta, po którą przyszliście.",
  },
  {
    numer: "02",
    tytul: "Zajęcia próbne",
    opis:
      "Dziecko wchodzi do grupy na normalnych zasadach — nie na pokazową lekcję dla rodziców. Po spotkaniu mówimy, co widzieliśmy.",
  },
  {
    numer: "03",
    tytul: "Zapis i karnet",
    opis:
      `Wybieracie liczbę programów. Zasady płatności i rezygnacji są w <a class="link-w-zdaniu" href="${"/regulamin"}">regulaminie</a>, nie w rozmowie telefonicznej.`,
  },
];
---

<Baza
  tytul="Angielski dla życia, nie tylko dla szkoły"
  opis="Centrum kompetencji w Szczecinie dla dzieci i młodzieży 5–19 lat. Zajęcia po angielsku, fakultety oraz przygotowanie do egzaminu ósmoklasisty i matury."
  pytania={pytania}
>
  {/* ── 1 ── HERO. Hasło, jedno zdanie, dwa przyciski. Bez grafiki wypełniającej. */}
  <section class="hero hero--foto" style="--foto-kadr: center 42%">
    <FotoNaglowka nazwa="motion-2" klasa="hero__foto" />
    <div class="szerokosc">
      <div class="hero__tresc">
        <h1 class="tytul-display">Angielski dla życia,<br />nie tylko dla szkoły.</h1>
        <p class="hero__zdanie">
          Centrum kompetencji w Szczecinie dla dzieci i młodzieży od 5 do 19 lat.
          Dzieci działają po angielsku — pytają, negocjują, rozwiązują problemy.
          Starsi przygotowują się do egzaminu ósmoklasisty i matury, z angielskiego
          i z matematyki.
        </p>
        <div class="przyciski">
          <a class="przycisk przycisk--akcja" href={url("/zapisy")}>
            Umów zajęcia próbne
          </a>
          <a class="przycisk przycisk--duch" href="#wiek">Sprawdź ofertę dla wieku dziecka</a>
          {tel && (
            <span class="telefon-obok">
              albo zadzwońcie: <a href={tel}>{telefonTekst()}</a>
            </span>
          )}
        </div>
        <ul class="hero__fakty">
          <li class="hero__fakt">{firma.miasto}, zajęcia stacjonarne</li>
          <li class="hero__fakt">Grupy {wielkoscGrupyTekst} osób</li>
          <li class="hero__fakt">Zajęcia podstawowe w całości po angielsku</li>
          <li class="hero__fakt">Start: {rokSzkolny.start}</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── 1b ── KAFLE TEMATYCZNE. Osiem obszarów kompetencji naraz — rodzic
       widzi zakres, zanim zacznie czytać. Podpis nazywa obszar, nigdy
       wydarzenie: to zdjęcia ilustracyjne i zdanie pod galerią musi zostać. */}
  <section class="sekcja sekcja--bez-gory">
    <div class="szerokosc">
      <div class="siatka siatka--osiem">
        {kafle.map((k) => (
          <figure class="kafel">
            <img
              class="kafel__kadr"
              src={url(`/foto/${k.plik}-800.webp`)}
              srcset={`${url(`/foto/${k.plik}-800.webp`)} 800w, ${url(`/foto/${k.plik}-1200.webp`)} 1200w, ${url(`/foto/${k.plik}-1600.webp`)} 1600w`}
              sizes="(min-width: 68rem) 16rem, (min-width: 40rem) 33vw, 100vw"
              alt={k.podpis}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="kafel__podpis">{k.podpis}</figcaption>
          </figure>
        ))}
      </div>
      <p class="nota-ilustracyjna">
        Zdjęcia ilustracyjne — po starcie zastępujemy je materiałem z własnych
        zajęć.
      </p>
    </div>
  </section>

  {/* ── 1c ── TRZY KROKI. Odpowiedź na pytanie „co się stanie, jak zadzwonię”,
       którego strona wcześniej nie obsługiwała wprost. */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Jak zaczynamy</span>
        <h2 class="tytul-1">Trzy kroki do pierwszych zajęć</h2>
        <p class="wiodacy">
          Decyzję o zapisie podejmujecie po zajęciach próbnych, nie przed.
          Dalej prowadzimy Was my.
        </p>
      </div>

      <div class="siatka siatka--troje">
        {trzyKroki.map((k) => (
          <article class="karta karta--luzna">
            <p class="krok__numer">{k.numer}</p>
            <h3 class="tytul-4">{k.tytul}</h3>
            <p class="tekst-maly tekst-drugi" set:html={k.opis} />
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── 2 ── SELEKTOR WIEKU. Największy element strony, prowadzi wprost do oferty. */}
  <section class="sekcja" id="wiek">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Zacznijcie stąd</span>
        <h2 class="tytul-1">Ile lat ma Wasze dziecko?</h2>
        <p class="wiodacy">
          Grupy dobieramy wiekiem. Sześciolatek i dziesięciolatek uczą się
          zupełnie inaczej. Wybierzcie przedział, żeby zobaczyć, co dokładnie
          dziecko robi na zajęciach.
        </p>
      </div>

      <div class="wiek">
        {grupyWiekowe.map((grupa) => (
          <a
            class={grupa.senior ? "wiek__karta wiek__karta--senior" : "wiek__karta"}
            href={url(grupa.href)}
          >
            <span class="wiek__lata">{grupa.lata}</span>
            <span class="wiek__nazwa">{grupa.nazwa}</span>
            <span class="wiek__opis">{grupa.opis}</span>
            <span class="wiek__strzalka">Zobacz ofertę →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── 3 ── JEDNA MISJA OD ŚRODKA. Szeroka kolumna zamiast siatki kafli. */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="misja">
        <div class="stos">
          <span class="nadtytul">Jedna misja od środka</span>
          <p class="misja__cytat">
            Dziś jesteś detektywem. Masz jedną wskazówkę po angielsku
            i dwadzieścia minut.
          </p>
          <p class="tekst-drugi">
            Tak wygląda pojedyncze spotkanie w grupie ośmio- i dziewięciolatków.
            Nikt nie zapowiada, że będzie „lekcja o czasie przeszłym”. Dziecko
            dostaje zagadkę i musi ją rozwiązać — a jedynym dostępnym narzędziem
            jest angielski.
          </p>
          <p class="tekst-drugi">
            Efekt uboczny jest zamierzony: po trzech miesiącach dziecko pyta
            o rzeczy po angielsku odruchowo, bo tak było szybciej niż po polsku.
          </p>
          <p>
            <a class="link-w-zdaniu" href={url("/podstawowe")}>
              Zobaczcie, jak zbudowane są zajęcia podstawowe
            </a>
          </p>
        </div>

        <div class="stos stos--ciasny">
          <h2 class="tytul-3">Przebieg spotkania</h2>
          <ol class="przebieg">
            {przebiegMisji.map((krok) => (
              <li class="przebieg__krok">
                <span class="przebieg__czas">{krok.czas}</span>
                <div class="przebieg__tresc">
                  <strong>{krok.tytul}</strong>
                  <p>{krok.opis}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4 ── DOWÓD. Metoda w trzech zdaniach + pasek źródeł. Nie sześć definicji. */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Dlaczego to działa</span>
          <h2 class="tytul-1">Metoda, nie intuicja</h2>
        </div>
        <div class="stos">
          {/* Brzmienie z sekcji „Wniosek dla modelu" aneksu naukowego.
              Poprzednia wersja mówiła, że OECD, UNESCO i EEF wskazują te
              podejścia jako skuteczniejsze od nauczania podającego — a to myli
              ramy programowe z dowodem skuteczności. Te organizacje opisują,
              które kompetencje są istotne; nie orzekają, który sposób uczenia
              działa lepiej. */}
          <p class="wiodacy">
            Program łączy podejścia, dla których istnieją dowody z badań:
            uczenie słownictwa wspierane ruchem i gestem, nauczanie języka
            oparte na zadaniach, ustrukturyzowana współpraca, informacja
            zwrotna oraz rozwijanie kompetencji społeczno-emocjonalnych
            i medialnych.
          </p>
          <p class="tekst-drugi">
            Od pierwszego spotkania angielski jest narzędziem do zrobienia
            czegoś, a nie przedmiotem do zaliczenia. Skuteczność sprawdzamy też
            lokalnie — mierzymy postawione umiejętności i jakość wdrożenia,
            nie ogólne wrażenie.
          </p>
          <p>
            <a class="link-w-zdaniu" href={url("/metoda")}>
              Przeczytajcie o metodzie i podziale na grupy wiekowe
            </a>
          </p>
          {/* Podpis pod sygnaturami jest obowiązkowy. Bez niego pasek nazw
              czyta się jako rekomendacja metody przez te organizacje — a żadna
              z nich takiej rekomendacji nie wystawiła. */}
          <ul class="zrodla">
            {zrodla.map((z) => <li class="zrodla__pozycja">{z}</li>)}
          </ul>
          <p class="tekst-drobny tekst-drugi">
            Kompetencje, które rozwijamy, wskazują jako istotne ramy programowe
            tych organizacji.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 5 ── EXAMS. Tu wchodzi wyróżnik: matematyka. */}
  <section class="sekcja sekcja--grafit">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul nadtytul--na-marce">Exams</span>
        <h2 class="tytul-1" style="color: var(--bialy);">
          Przygotowanie do egzaminów — także z matematyki
        </h2>
        <p class="wiodacy" style="color: var(--tekst-na-marce-miekki);">
          Przygotowanie egzaminacyjne prowadzimy z angielskiego i z matematyki.
          Można je wybrać osobno, niezależnie od zajęć podstawowych — także jeśli
          dziecko nie chodzi u nas na nic innego.
        </p>
      </div>

      <div class="siatka siatka--2">
        <article class="karta karta--luzna karta--na-grafitcie">
          <span class="plakietka plakietka--na-marce">13–15 lat</span>
          <h3 class="tytul-3" style="color: var(--bialy);">Egzamin ósmoklasisty</h3>
          <p class="tekst-maly" style="color: var(--tekst-na-marce-miekki);">
            Arkusze CKE, strategie zadań, oswojenie z formatem. Ton rówieśniczy,
            bez maskotek.
          </p>
          <ul class="lista-znaczona" style="margin-top: var(--space-1);">
            <li style="color: var(--tekst-na-marce-miekki);">Angielski — poziom A2+</li>
            <li style="color: var(--tekst-na-marce-miekki);">
              Matematyka <span class="plakietka unikat">Unikat</span>
            </li>
          </ul>
          <a class="przycisk przycisk--duch" href={url("/exams/egzamin-osmoklasisty")} style="margin-top: var(--space-2); justify-self: start;">
            Zobacz przygotowanie do E8
          </a>
        </article>

        <article class="karta karta--luzna karta--na-grafitcie">
          <span class="plakietka plakietka--na-marce">Teens Senior · 16–19 lat</span>
          <h3 class="tytul-3 tytul--medrzec" style="color: var(--bialy);">
            Konkretny plan na maturę
          </h3>
          <p class="tekst-maly" style="color: var(--tekst-na-marce-miekki);">
            Praca na arkuszach CKE, progi punktowe, harmonogram do maja. Liczy się wynik.
          </p>
          <ul class="lista-znaczona" style="margin-top: var(--space-1);">
            <li style="color: var(--tekst-na-marce-miekki);">
              Angielski — podstawowy i rozszerzony
            </li>
            <li style="color: var(--tekst-na-marce-miekki);">
              Matematyka — poziom podstawowy <span class="plakietka unikat">Unikat</span>
            </li>
          </ul>
          <a class="przycisk przycisk--duch" href={url("/exams/matura")} style="margin-top: var(--space-2); justify-self: start;">
            Zobacz przygotowanie do matury
          </a>
        </article>
      </div>

      <p class="wiodacy" style="color: var(--tekst-na-marce-miekki); margin-top: var(--space-4); max-width: 46rem;">
        To jedyne miejsce w Szczecinie, gdzie przygotowanie do matury
        z angielskiego i z matematyki prowadzi ten sam zespół, w tym samym
        budynku, w jednym grafiku. Matematykę prowadzi jedna z założycielek
        centrum.
      </p>

      <div style="margin-top: var(--space-4); max-width: var(--szerokosc-tekstu);">
        <DoUzupelnienia czego="Prowadząca matematykę">
          Najmocniejszym dowodem nie jest plakietka „Unikat”, tylko nazwisko.
          Wpiszcie tu imię, nazwisko, wykształcenie i doświadczenie egzaminacyjne
          założycielki prowadzącej matematykę, a potem powtórzcie tę notkę na obu
          stronach matematyki, z odesłaniem do „O nas”. To zamienia wyróżnik
          z hasła w konkret.
        </DoUzupelnienia>
      </div>
    </div>
  </section>

  {/* ── 6 ── KONKRETY I ZAPIS. Praktyka zamiast wartości. */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="siatka--boczna">
        <div class="stos">
          <div class="naglowek-sekcji" style="margin-bottom: 0;">
            <span class="nadtytul">Konkrety</span>
            <h2 class="tytul-1">Zanim zapytacie</h2>
          </div>

          <ul class="lista-rozdzielona">
            <li>
              <span class="etykieta">Gdzie</span>
              <span class="wartosc">
                {firma.ulica
                  ? `${firma.ulica}, ${firma.miasto}`
                  : `${firma.miasto} — adres w uzupełnieniu`}
              </span>
            </li>
            <li>
              <span class="etykieta">Kiedy</span>
              <span class="wartosc">
                {pokazTerminarz ? (
                  <>Popołudniami — <a href={url("/terminarz")}>zobacz terminarz</a></>
                ) : (
                  "Popołudniami — dni i godziny w uzupełnieniu"
                )}
              </span>
            </li>
            <li>
              <span class="etykieta">Wielkość grupy</span>
              <span class="wartosc">{wielkoscGrupyTekst} osób</span>
            </li>
            <li>
              <span class="etykieta">Start</span>
              <span class="wartosc">
                {rokSzkolny.start} — rok szkolny {rokSzkolny.etykieta}
              </span>
            </li>
            <li>
              <span class="etykieta">Ubezpieczenie</span>
              {/* Czas przyszły, dopóki polisy nie ma. Zdanie zmieni się samo
                  po przestawieniu `ubezpieczenie.wykupione` w site.js. */}
              <span class="wartosc">
                {ubezpieczenie.wykupione
                  ? "Wykupione — odpowiedzialność cywilna placówki"
                  : "Odpowiedzialność cywilna placówki — przed pierwszymi zajęciami"}
              </span>
            </li>
          </ul>

          <DoUzupelnienia czego="Adres, godziny i data zamknięcia naboru">
            Termin startu już tu stoi. Zostają trzy rzeczy, które zamieniają
            „kiedyś się zapiszemy" w „napiszmy dziś": adres lokalu
            (<code>firma.ulica</code>), grafik (<code>terminarz.dni</code> wraz
            z przełącznikiem <code>terminarz.pokazuj</code>) oraz data
            zamknięcia naboru. Wszystkie w <code>src/lib/site.js</code>.
            <br /><br />
            Po zawarciu polisy przestawcie <code>ubezpieczenie.wykupione</code>
            na <code>true</code> — zdanie wyżej i odpowiedź w pytaniach zmienią
            się z zobowiązania na fakt same.
          </DoUzupelnienia>
        </div>

        <div class="stos">
          <article class="karta">
            <h3 class="tytul-4">Zajęcia podstawowe i fakultety</h3>
            <p class="tekst-maly tekst-drugi">
              Karnet na dziesięć miesięcy roku szkolnego. Każdy kolejny fakultet
              obniża cenę jednostkową spotkania.
            </p>
          </article>
          <article class="karta">
            <h3 class="tytul-4">Exams i zajęcia indywidualne</h3>
            <p class="tekst-maly tekst-drugi">
              Bez karnetu, rozliczenie za pojedyncze spotkanie. Można wziąć sam
              egzamin, bez zajęć podstawowych.
            </p>
          </article>
          <a class="przycisk przycisk--obrys" href={url("/cennik")}>
            Zobacz pełny cennik
          </a>
          <p class="tekst-drobny">Wszystkie stawki razem z zakresem zajęć, bez gwiazdek.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 7 ── PYTANIA. Rozwijane, bo rodzic szuka jednej odpowiedzi, a nie
       czyta całości. Domyślnie zamknięte — otwarta lista dziewięciu pytań
       wygląda jak regulamin i odstrasza. Te same treści idą do danych
       strukturalnych, więc mogą trafić wprost do wyniku wyszukiwania. */}
  <section class="sekcja" id="pytania">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Pytania</span>
          <h2 class="tytul-1">Co rodzice pytają najczęściej</h2>
        </div>
        <div class="stos">
          <div class="pytania">
            {pytania.map((p) => (
              <details>
                <summary>{p.pytanie}</summary>
                <p class="pytania__odpowiedz">{p.odpowiedz}</p>
              </details>
            ))}
          </div>
          <p class="tekst-drobny">
            Nie ma tu odpowiedzi na Wasze pytanie? Zadzwońcie albo napiszcie —
            a jeśli czegoś jeszcze nie wiemy, powiemy wprost, kiedy będzie
            wiadomo.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Wezwanie zamykające */}
  <section class="sekcja sekcja--tint">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <h2 class="tytul-2">Przyjdźcie zobaczyć jedną misję</h2>
        </div>
        <div class="stos">
          <p class="wiodacy">
            Bezpłatne zajęcia próbne, bez zobowiązań. Dziecko bierze udział na
            normalnych zasadach, Wy patrzycie z boku. Potem rozmawiamy.
          </p>
          <div class="przyciski">
            <a class="przycisk przycisk--akcja" href={url("/zapisy")}>
              Umów zajęcia próbne
            </a>
            {tel && (
              <span class="telefon-obok">
                albo zadzwońcie: <a href={tel}>{telefonTekst()}</a>
              </span>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</Baza>
