---
import StronaPrawna from "../components/StronaPrawna.astro";

const sekcje = [
  {
    tytul: "1. Kto jest administratorem danych",
    tresc:
      "Administratorem danych zbieranych w tym serwisie jest podmiot prowadzący centrum Skills Academy w Szczecinie.",
    doUstalenia:
      "Pełna nazwa podmiotu, forma prawna, adres siedziby, NIP, REGON, adres e-mail i telefon kontaktowy. Jeśli powołaliście inspektora ochrony danych — jego dane kontaktowe.",
  },
  {
    tytul: "2. Jakie dane zbieramy",
    tresc:
      "W formularzu zapisu zbieramy imię dziecka, jego wiek, numer telefonu rodzica i opcjonalnie adres e-mail. Serwis zbiera też podstawowe dane techniczne wizyty.",
    doUstalenia:
      "Pełna lista danych z formularza po ostatecznym ustaleniu pól.",
  },
  {
    tytul: "3. W jakim celu i na jakiej podstawie",
    tresc:
      "Dane z formularza służą wyłącznie kontaktowi w sprawie zajęć próbnych i zapisu dziecka.",
    doUstalenia:
      "Do potwierdzenia przez prawnika: podstawy prawne dla każdego celu — zgoda, wykonanie umowy, obowiązek prawny, prawnie uzasadniony interes.",
  },
  {
    tytul: "4. Jak długo przechowujemy dane",
    tresc:
      "Dane osób, które nie zdecydowały się na zapis, usuwamy po zakończeniu kontaktu. Dane uczestników przechowujemy przez okres wymagany przepisami.",
    doUstalenia:
      "Konkretne okresy przechowywania dla każdej kategorii danych — zgłoszenia bez zapisu, dane uczestników, dokumentacja księgowa, zgody wizerunkowe.",
  },
  {
    tytul: "5. Komu przekazujemy dane",
    tresc:
      "Danych nie sprzedajemy i nie udostępniamy w celach marketingowych podmiotom trzecim. Korzystamy z usług, które przetwarzają dane w naszym imieniu: dostawcy hostingu strony, dostawcy poczty obsługującej formularze oraz narzędzia Umami do statystyk odwiedzin. Zgłoszenia z formularzy nie są nigdzie zapisywane — trafiają wyłącznie na naszą skrzynkę pocztową.",
    doUstalenia:
      "Pełna lista podmiotów przetwarzających z nazwami i umowami powierzenia: hosting, poczta, biuro rachunkowe. Trzy z nich są już znane i wymienione wyżej, brakuje biura rachunkowego i ewentualnych innych.",
  },
  {
    tytul: "6. Wasze prawa",
    tresc:
      "Macie prawo dostępu do danych, ich sprostowania, usunięcia, ograniczenia przetwarzania, przenoszenia oraz sprzeciwu. Zgodę można wycofać w każdej chwili, bez wpływu na zgodność z prawem wcześniejszego przetwarzania.",
    doUstalenia:
      "Sposób realizacji wniosków i termin odpowiedzi. Dodać informację o prawie skargi do Prezesa Urzędu Ochrony Danych Osobowych.",
  },
  {
    tytul: "7. Pliki cookies i statystyki odwiedzin",
    tresc:
      "Serwis używa plików cookies niezbędnych do jego działania i do obsługi formularzy. Do statystyk odwiedzin używamy narzędzia Umami, które nie zapisuje niczego na Waszym urządzeniu, nie tworzy profilu i nie śledzi Was na innych stronach. Zbiera wyłącznie dane zbiorcze: liczbę odsłon poszczególnych podstron, kraj, rodzaj urządzenia i adres, z którego przyszliście. Adres IP jest przy tym przetwarzany przejściowo, żeby ustalić kraj, i nie jest zapisywany. Prawo nie wymaga tu zgody, ponieważ narzędzie nie sięga do pamięci urządzenia — mimo to pytamy o nią w banerze, a odmowa naprawdę wyłącza licznik. Podstawą przetwarzania jest Wasza zgoda, a gdyby jej zabrakło — nasz uzasadniony interes polegający na sprawdzeniu, czy strona działa i czy da się na niej znaleźć to, po co ludzie przychodzą. Wybór można zmienić w każdej chwili odnośnikiem „Zgody cookies” w stopce. Serwery Umami znajdują się poza Europejskim Obszarem Gospodarczym, więc dane statystyczne są tam przekazywane — dostawca deklaruje standardowe klauzule umowne jako podstawę takiego przekazania. Gdybyśmy kiedykolwiek wdrożyli narzędzie zapisujące cookies albo piksel reklamowy, wróci pytanie o zgodę w banerze, a bez niej taki skrypt się nie uruchomi.",
    doUstalenia:
      "Potwierdzenie u dostawcy Umami, na jakiej dokładnie podstawie odbywa się przekazanie danych poza Europejski Obszar Gospodarczy, i wpisanie jej tutaj słowo w słowo. Jeśli statystyki mają zostać w Unii, alternatywą jest Plausible albo Umami postawione na własnym serwerze — kod obsługuje oba warianty, zmiana to dwie linijki.",
  },
  {
    tytul: "8. Dane dzieci",
    tresc:
      "Dane dziecka podaje rodzic lub opiekun prawny. Dziecko nie zapisuje się samodzielnie.",
    doUstalenia:
      "Do potwierdzenia przez prawnika: zapis o zgodzie opiekuna oraz powiązanie z zasadami wizerunku opisanymi na stronie Bezpieczeństwo.",
  },
];
---

<StronaPrawna
  tytul="Polityka prywatności"
  opis="Jakie dane zbiera serwis Skills Academy, w jakim celu, jak długo je przechowujemy i jakie prawa przysługują osobom, których dane dotyczą."
  wstep="Opisujemy tu, jakie dane zbieramy przez ten serwis, po co i na jak długo. Dokument jest w wersji roboczej — przed publikacją musi go potwierdzić prawnik."
  sekcje={sekcje}
/>
