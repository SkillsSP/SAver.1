---
import StronaPrawna from "../components/StronaPrawna.astro";

/* Struktura i brzmienie przepisane z makiety Regulamin.dc.html (wersja z
   sierpnia 2026). Względem poprzedniej wersji rozdzielono zawieszenie karnetu
   od rezygnacji, dopisano prawo odstąpienia od umowy zawartej na odległość
   oraz odpowiedzialność za rzeczy pozostawione w centrum.

   Pole `ryzyko` oznacza zapisy, które w umowie z konsumentem bywają
   kwestionowane jako klauzule niedozwolone — wymagają uwagi prawnika
   w pierwszej kolejności. */
const sekcje = [
  {
    tytul: "1. Kto prowadzi zajęcia",
    tresc: "Zajęcia prowadzi centrum kompetencji Skills Academy w Szczecinie.",
    doUstalenia:
      "Pełna nazwa podmiotu, adres, NIP, REGON, dane kontaktowe, forma prawna działalności.",
  },
  {
    tytul: "2. Zapis na zajęcia",
    tresc:
      "Zapis następuje po zajęciach próbnych, na podstawie formularza i potwierdzenia ze strony centrum. Dziecko zapisuje rodzic lub opiekun prawny.",
    doUstalenia:
      "Moment zawarcia umowy, wymagane dokumenty, lista osób upoważnionych do odbioru, informacje o zdrowiu dziecka.",
  },
  {
    tytul: "3. Opłaty i płatność",
    tresc:
      "Kurs obejmuje rok szkolny. Opłata dzieli się na dziesięć równych rat, płatnych co miesiąc od września do czerwca. Wysokość raty zależy od liczby wybranych programów i jest stała — nie zmienia się wraz z liczbą spotkań przypadających na dany miesiąc, ponieważ obejmuje cały rok, a nie pojedyncze zajęcia. Płatność następuje przelewem na konto centrum. Przygotowanie egzaminacyjne (Exams) rozliczane jest osobno, poza karnetem grupowym; zajęcia indywidualne opłacane są za spotkanie.",
    doUstalenia:
      "Dzień miesiąca, do którego wpływa rata, numer konta, zasady wystawiania faktur oraz konsekwencje opóźnienia płatności.",
  },
  {
    tytul: "4. Rezygnacja w trakcie roku szkolnego",
    tresc:
      "Z ważnego powodu można zrezygnować z zajęć przed końcem roku szkolnego. Miesiąc, w którym rodzic zgłosi rezygnację, jest wówczas ostatnim płatnym z dziesięciu — kolejnych rat nie naliczamy i nie żądamy dopłaty za zajęcia, które już się odbyły. Za ważny powód uznajemy w szczególności dłuższą chorobę uczestnika, przeprowadzkę oraz zmianę szkoły. Wyliczenie to nie jest zamknięte; w razie wątpliwości rozstrzygamy na korzyść rodzica.",
    ryzyko:
      "Poprzednia wersja przewidywała zawieszenie karnetu z powrotem spotkań do puli — konstrukcję, której cennik roczny nie zna. Obecne brzmienie odpowiada modelowi rocznemu, ale wymaga uwagi w dwóch punktach. Po pierwsze, umowa roczna z konsumentem bez żadnej ścieżki wyjścia bywa kwestionowana jako klauzula niedozwolona; ten zapis taką ścieżkę tworzy. Po drugie, otwarte wyliczenie „ważnego powodu” działa na korzyść rodzica tylko wtedy, gdy centrum nie ocenia go arbitralnie — dlatego dopisane jest zdanie o rozstrzyganiu na korzyść rodzica. Całość do zatwierdzenia przez prawnika.",
    doUstalenia:
      "Forma zgłoszenia rezygnacji (pismo, e-mail, formularz) oraz dzień miesiąca, do którego zgłoszenie musi wpłynąć, żeby dany miesiąc był ostatnim płatnym.",
  },
  {
    tytul: "5. Rozliczenie i zwroty",
    tresc:
      "Rat już zapłaconych za miesiące, w których zajęcia się odbyły, nie zwracamy — obejmowały wykonaną usługę. Jeżeli rezygnacja wynika z przyczyn po naszej stronie, na przykład z odwołania grupy albo zmiany terminu niemożliwej do przyjęcia przez rodzica, zwracamy część raty przypadającą na niezrealizowane zajęcia w terminie 14 dni. Nie pobieramy wpisowego ani opłaty za spotkanie odwołane z wyprzedzeniem.",
    ryzyko:
      "Najwcześniejsza wersja mówiła „wpłaconych środków nie zwracamy”. Bezwarunkowe wyłączenie zwrotu w umowie z konsumentem to jeden z najczęściej kwestionowanych zapisów w tej branży. Obecne brzmienie rozdziela dwa przypadki: rezygnację rodzica i przyczynę po stronie centrum. Termin zwrotu i sposób wyliczenia części raty musi zatwierdzić prawnik.",
    doUstalenia:
      "Sposób wyliczenia części raty przypadającej na niezrealizowane zajęcia oraz tryb zgłaszania roszczenia o zwrot.",
  },
  {
    tytul: "6. Odstąpienie od umowy zawartej na odległość",
    tresc:
      "Jeżeli umowa została zawarta przez formularz na stronie lub telefonicznie, rodzic może odstąpić od niej w terminie 14 dni od zawarcia, bez podania przyczyny i bez kosztów. Jeżeli na wyraźną prośbę rodzica zajęcia rozpoczną się przed upływem tego terminu, przy odstąpieniu rozliczamy proporcjonalnie spotkania, które już się odbyły.",
    ryzyko:
      "Tej sekcji wcześniej nie było. Przy zapisie przez formularz przepisy o prawie odstąpienia stosują się niezależnie od tego, czy regulamin o nich wspomina — ich pominięcie nie wyłącza uprawnienia, a bywa traktowane jako wprowadzanie konsumenta w błąd.",
    doUstalenia:
      "Wzór oświadczenia o odstąpieniu i adres, na który je kierować. Do potwierdzenia przez prawnika: brzmienie zgody na rozpoczęcie zajęć przed upływem 14 dni.",
  },
  {
    tytul: "7. Nieobecności i odrabianie",
    tresc:
      "Nieobecność zgłoszoną z wyprzedzeniem można odrobić w innej grupie tego samego poziomu.",
    doUstalenia:
      "Minimalne wyprzedzenie zgłoszenia, limit odrabianych zajęć oraz zasady przy zajęciach indywidualnych. Dłuższa choroba nie wymaga tu osobnej reguły — obejmuje ją sekcja 4.",
  },
  {
    tytul: "8. Odwołanie zajęć przez centrum",
    tresc:
      "Jeśli zajęcia nie odbędą się z przyczyn po naszej stronie, wyznaczamy termin zastępczy. Jeżeli termin zastępczy nie dojdzie do skutku, spotkanie rozliczamy albo zwracamy.",
    doUstalenia:
      "Tryb informowania rodziców, termin odrobienia, zasady przy odwołaniu z przyczyn niezależnych oraz minimalna liczebność grupy, poniżej której grupa nie rusza.",
  },
  {
    tytul: "9. Obowiązki uczestnika i rodzica",
    tresc:
      "Uczestnik przestrzega zasad bezpieczeństwa i zasad współpracy w grupie. Rodzic zapewnia punktualne przyprowadzenie i odbiór dziecka.",
    doUstalenia:
      "Zasady zachowania oraz tryb postępowania przy powtarzającym się naruszaniu zasad — z zapisem, że rozwiązanie umowy przez centrum jest ostatecznością i poprzedza je rozmowa z rodzicem.",
  },
  {
    tytul: "10. Rzeczy pozostawione w centrum",
    tresc:
      "Za rzeczy zgubione lub zniszczone w centrum odpowiadamy na zasadach ogólnych. Prosimy, żeby dzieci nie przynosiły na zajęcia wartościowych przedmiotów, których nie potrzebują — nie zapewniamy dla nich osobnego przechowania.",
    ryzyko:
      "Częsty w tej branży zapis „nie ponosimy odpowiedzialności za rzeczy pozostawione” jest bezwarunkowym wyłączeniem odpowiedzialności wobec konsumenta i bywa kwestionowany. Powyższe brzmienie zachowuje prośbę do rodziców, ale nie wyłącza odpowiedzialności z góry.",
    doUstalenia:
      "Do potwierdzenia przez prawnika: czy centrum chce wprowadzić depozyt na wartościowe przedmioty i na jakich zasadach.",
  },
  {
    tytul: "11. Wizerunek i dane osobowe",
    tresc:
      "Publikacja zdjęć wymaga odrębnej, pisemnej zgody rodzica, którą można wycofać w każdej chwili. Szczegóły opisujemy w Standardach Ochrony Małoletnich oraz w polityce prywatności.",
    doUstalenia:
      "Wzór zgody wizerunkowej i termin usunięcia materiałów po wycofaniu zgody.",
  },
  {
    tytul: "12. Reklamacje i zmiany regulaminu",
    tresc:
      "Uwagi i reklamacje przyjmujemy pisemnie, na adres e-mail centrum, i odpowiadamy na nie w terminie 14 dni. O zmianie regulaminu informujemy z wyprzedzeniem; jeżeli rodzic nie akceptuje zmiany, może rozwiązać umowę bez zachowania okresu wypowiedzenia.",
    ryzyko:
      "Zapis o jednostronnej zmianie regulaminu bez prawa rezygnacji jest typową klauzulą kwestionowaną w umowach z konsumentem. Powyższe brzmienie daje rodzicowi wyjście, co jest rynkowym standardem.",
    doUstalenia:
      "Wyprzedzenie, z jakim informujecie o zmianach (najczęściej 14 dni), oraz kanał informowania — e-mail czy ogłoszenie w centrum.",
  },
];
---

<StronaPrawna
  tytul="Regulamin"
  opis="Zasady uczestnictwa w zajęciach Skills Academy w Szczecinie: zapis, opłaty w dziesięciu ratach, rezygnacja i zwroty, odstąpienie od umowy, obowiązki stron."
  wstep="Zasady, na jakich prowadzimy zajęcia i na jakich zapisujecie dziecko. Dokument jest w wersji roboczej — przed publikacją musi go potwierdzić prawnik."
  uwagaWstepna="Regulamin jest umową z konsumentem, więc całość wymaga weryfikacji pod kątem klauzul niedozwolonych. Zapisy najbardziej narażone przepisaliśmy na brzmienie odpowiadające standardowi rynkowemu i oznaczyliśmy je poniżej."
  sekcje={sekcje}
/>
