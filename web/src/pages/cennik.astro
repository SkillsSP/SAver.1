---
import Baza from "../layouts/Baza.astro";
import PozycjaCennika from "../components/PozycjaCennika.astro";
import DoUzupelnienia from "../components/DoUzupelnienia.astro";
import ZapisCta from "../components/ZapisCta.astro";
import { url, wielkoscGrupyTekst, firma,
  cenyOd,
} from "../lib/site.js";
import FotoNaglowka from "../components/FotoNaglowka.astro";

/* ==========================================================================
   CENNIK 2026/2027

   Model: cena zależy od LICZBY PROGRAMÓW, nie od typu zajęć. Program to albo
   Useful & Life Skills, albo jeden fakultet tematyczny. To zmiana wobec
   poprzedniej wersji strony, która sprzedawała fakultet jako dopłatę do bazy.

   Konsekwencja, którą trzeba znać: cennik pozwala wziąć sam fakultet, bez
   zajęć podstawowych. Dokumentacja marki mówiła odwrotnie — decyzją
   właścicielską idziemy za cennikiem, więc to dokumenty marki wymagają
   przepisania, nie ta strona.

   Usunięte konstrukcje, których cennik nie przewiduje, a poprzednia wersja
   strony obiecywała: karnet miesięczny i semestralny jako dwa modele, rabat
   za płatność semestralną z góry, rabat za drugi fakultet, zawieszenie
   karnetu z powrotem spotkań do puli, zniżka na Exams dla uczestnika zajęć.
   ========================================================================== */

/* Trzy progi. Renderowane jako wiersze, nie karty — przy trzech elementach
   każda siatka `auto-fit` ma szerokość, na której zostaje sierotka. */
const progi = [
  {
    nazwa: "Jeden program",
    opis: "Useful & Life Skills albo jeden fakultet tematyczny. Raz w tygodniu.",
    kwota: cenyOd.programy,
    okres: "/ mies.",
    wariant: "45 minut tygodniowo",
  },
  {
    nazwa: "Jeden program, dłuższe spotkanie",
    opis: "Ten sam zakres, spotkanie o kwadrans dłuższe.",
    kwota: "250 zł",
    okres: "/ mies.",
    wariant: "60 minut tygodniowo",
  },
  {
    nazwa: "Dwa programy",
    opis: "Na przykład Useful & Life Skills plus Music Skills.",
    kwota: "360 zł",
    okres: "/ mies.",
    wariant: "2 × 45 minut tygodniowo",
    osobno: "400 zł",
  },
  {
    nazwa: "Trzy programy",
    opis: "Pełny tydzień — zajęcia podstawowe i dwa fakultety.",
    kwota: "500 zł",
    okres: "/ mies.",
    wariant: "3 × 45 minut tygodniowo",
    osobno: "600 zł",
  },
];

/* ROZBICIE NA TRZY GRUPY.

   Do tej pory wszystko, co nie było karnetem, stało w jednej sekcji o nagłówku
   „Exams, zajęcia 1:1 i minigrupy" — czyli w nagłówku, który sam przyznawał,
   że jest wyliczanką, a nie kategorią. Leżały tam obok siebie trzy różne
   sposoby rozliczenia: miesięczny (Exams), za spotkanie (zajęcia 1:1)
   i ustalany indywidualnie (minigrupa). Rodzic musiał to rozdzielić w głowie.

   Teraz rozdziela to strona. */

/* Zajęcia jeden na jeden — rozliczane za spotkanie, bez zobowiązania na rok. */
const indywidualne = [
  {
    nazwa: "Zajęcia indywidualne · 45 minut",
    opis: "Jeden prowadzący, jedno dziecko.",
    kwota: cenyOd.indywidualne,
    okres: "/ spotkanie",
  },
  {
    nazwa: "Zajęcia indywidualne · 60 minut",
    opis: "Najczęściej wybierany wariant.",
    kwota: "150 zł",
    okres: "/ spotkanie",
  },
  {
    /* Spotkanie trwa 90 minut, nie 80. Stało tu wcześniej „80 minut", czyli
       sam czas nauki bez przerwy — a rodzic planujący odbiór dziecka liczy
       czas od wejścia do wyjścia. Przerwa jest teraz nazwana wprost, bo przy
       spotkaniu półtoragodzinnym to jest informacja, nie drobiazg. */
    nazwa: "Zajęcia indywidualne · 90 minut",
    opis:
      "Dwa bloki po 40 minut z dziesięciominutową przerwą. Praca na pełnych arkuszach egzaminacyjnych.",
    kwota: "180 zł",
    okres: "/ spotkanie",
  },
];

/* Ścieżki rozliczane poza karnetem i poza cennikiem za spotkanie. */
const osobneSciezki = [
  {
    nazwa: "Exams",
    opis: "Przygotowanie do egzaminu ósmoklasisty albo matury. Osobna oferta, poza zajęciami podstawowymi.",
    kwota: cenyOd.exams,
    okres: "/ mies.",
    wariant: "2 × 45 minut albo 1 × 90 minut tygodniowo",
  },
  {
    nazwa: "Minigrupa 2–4 osoby",
    opis: "Na życzenie uczestników — na przykład dwoje rodzeństwa albo troje znajomych z klasy.",
    kwota: "cena indywidualna",
  },
];

/* Zajęcia próbne stoją przy karnetach, a nie w worku „poza karnetem".
   To jedno pełne spotkanie W GRUPIE, więc należą do oferty grupowej — i są
   pierwszym krokiem do niej, nie osobną ścieżką. */
const zajeciaProbne = {
  nazwa: "Zajęcia próbne",
  opis: "Jedno pełne spotkanie w grupie, na normalnych zasadach. Bez zobowiązań.",
  kwota: "bezpłatne",
  wyroznione: true,
};

const pytania = [
  {
    pytanie: "Co, jeśli dziecko zachoruje?",
    odpowiedz:
      "Rata jest stała i nie zależy od liczby spotkań w miesiącu — tak samo, jak nie rośnie w miesiącach dłuższych. Pojedynczą nieobecność zgłoszoną z wyprzedzeniem odrabiamy w innej grupie tego samego poziomu. Przy dłuższej chorobie obowiązuje reguła rezygnacji opisana wyżej.",
  },
  {
    pytanie: "Czy mogę zrezygnować w trakcie roku?",
    odpowiedz:
      "Tak, z ważnego powodu. Miesiąc, w którym zgłosicie rezygnację, jest wtedy ostatnim płatnym — pozostałych rat nie naliczamy i nie żądamy dopłaty za zajęcia, które się już odbyły. Za ważny powód uznajemy między innymi dłuższą chorobę, przeprowadzkę i zmianę szkoły; lista nie jest zamknięta.",
  },
  {
    pytanie: "Czy trzeba brać zajęcia podstawowe?",
    odpowiedz:
      "Nie. Cena zależy od liczby programów, a nie od tego, które wybierzecie. Można wziąć sam fakultet. Warto jednak wiedzieć, że angielski w działaniu jest podstawą tego, co robimy — dziecko, które przychodzi wyłącznie na Motion Skills, dostaje zajęcia ruchowe prowadzone po angielsku, a nie program językowy.",
  },
  {
    pytanie: "Czy zniżka rodzinna i program poleceń się łączą?",
    odpowiedz:
      "Tak. To dwa niezależne mechanizmy: zniżka rodzinna jest stałym obniżeniem ceny, a 50 zł za polecenie jednorazową nagrodą. Polecenie nie zabiera zniżki rodzinnej.",
  },
  {
    pytanie: "Jak wygląda płatność?",
    odpowiedz:
      "Przelewem na konto centrum, raz w miesiącu, przez dziesięć miesięcy od września do czerwca. Fakturę wystawiamy na życzenie, także na firmę.",
  },
];
/* Dane strukturalne oferty. Wyszukiwarka pokazuje przy takim kursie cenę
   i walutę wprost w wyniku, więc rodzic widzi „od 200 zł", zanim kliknie.

   Podajemy WYŁĄCZNIE progi grupowe: mają jedną, jednoznaczną cenę miesięczną.
   Minigrupa z ceną ustalaną indywidualnie nie ma czego zadeklarować, a kurs
   bez ceny w znaczniku bywa odrzucany razem z całą stroną.

   `category` mówi, że to zajęcia stacjonarne — bez tego wyszukiwarka
   traktuje kurs jako zdalny i pokazuje go poza obszarem lokalnym, czyli
   dokładnie odwrotnie do tego, o co nam chodzi. */
const znacznikOferty = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Zajęcia w Skills Academy",
  description:
    "Zajęcia po angielsku dla dzieci i młodzieży 5–19 lat: Useful & Life Skills oraz fakultety Music, Art, Acting i Motion Skills.",
  provider: {
    "@type": "EducationalOrganization",
    name: firma.nazwa,
    url: "https://skilful.pl/",
  },
  hasCourseInstance: progi.map((p) => ({
    "@type": "CourseInstance",
    name: p.nazwa,
    courseMode: "onsite",
    courseWorkload: p.wariant,
    location: {
      "@type": "Place",
      address: { "@type": "PostalAddress", addressLocality: firma.miasto, addressCountry: "PL" },
    },
    offers: {
      "@type": "Offer",
      price: p.kwota.replace(/[^\d]/g, ""),
      priceCurrency: "PLN",
      category: "Zajęcia stacjonarne",
      availability: "https://schema.org/InStock",
      url: "https://skilful.pl/cennik",
    },
  })),
};
---

<Baza
  aktywna="cennik"
  tytul="Cennik 2026/2027"
  opis="Cena zależy od liczby programów: od 200 zł miesięcznie. Grupy 5–8 osób, dziesięć rat od września do czerwca, pierwsze zajęcia bezpłatne. Szczecin."
  pytania={pytania}
  okruszki={[{ nazwa: "Cennik" }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(znacznikOferty)} />

  <section class="naglowek-strony naglowek-strony--foto" style="--foto-kadr: center 40%">
    <FotoNaglowka nazwa="motion-5" />
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Cennik 2026/2027</span>
        <h1 class="tytul-1">Jedna cena, bez dopisków drobnym drukiem</h1>
        <p class="hero__zdanie">
          Płacicie za liczbę programów, nie za ich rodzaj. Materiały
          i konsultacje z prowadzącym są w cenie. Nie pobieramy wpisowego ani
          opłaty za spotkanie odwołane w terminie.
        </p>
        <ul class="naglowek-strony__meta">
          <li>Od 200 zł miesięcznie</li>
          <li>Grupy {wielkoscGrupyTekst} osób</li>
          <li>Pierwsze zajęcia bezpłatne</li>
        </ul>
      </div>
    </div>
  </section>

  {/* PROGI — wiersze, nie karty. Powód w komentarzu przy .progi w arkuszu. */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Zajęcia w grupie</span>
        <h2 class="tytul-1">Cena zależy od liczby programów</h2>
        <p class="wiodacy">
          Program to albo Useful &amp; Life Skills, albo jeden fakultet
          tematyczny — Music, Art, Acting lub Motion Skills. Wybór należy do
          Was i nie zmienia stawki.
        </p>
      </div>

      <div class="progi">
        {progi.map((pozycja) => <PozycjaCennika {...pozycja} />)}
        <PozycjaCennika {...zajeciaProbne} />
      </div>

      <p class="tekst-maly tekst-drugi" style="margin-top: var(--space-3); max-width: var(--szerokosc-tekstu);">
        Grupy liczą {wielkoscGrupyTekst} osób. Dolna granica jest warunkiem
        uruchomienia grupy — przy mniejszej liczbie zapisanych proponujemy
        minigrupę albo inny termin.
      </p>
    </div>
  </section>

  {/* ZAJĘCIA INDYWIDUALNE — rozliczane za spotkanie, nie miesięcznie */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Jeden na jeden</span>
        <h2 class="tytul-1">Zajęcia indywidualne</h2>
        <p class="wiodacy">
          Płacicie za spotkanie, bez zobowiązania na rok. Cena zależy wyłącznie
          od długości spotkania — nie od tego, czego dotyczy.
        </p>
      </div>

      <div class="progi">
        {indywidualne.map((pozycja) => <PozycjaCennika {...pozycja} />)}
      </div>
    </div>
  </section>

  {/* OSOBNE ŚCIEŻKI — inny sposób rozliczenia niż dwa powyższe.

      TŁO SEKCJI. Trzecia grupa musiała dostać własne tło, bo sąsiaduje
      z sekcją „karta" z góry i ze zniżkami z dołu — przy powtórzeniu
      któregokolwiek z nich dwie sąsiednie sekcje zlałyby się w jedną.
      `sekcja--tint` różni się od obu na tyle, że wykrywacz rytmu sekcji
      w audycie dostępności to przepuszcza. */}
  <section class="sekcja sekcja--tint">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Osobne ścieżki</span>
        <h2 class="tytul-1">Exams i minigrupy</h2>
        <p class="wiodacy">
          Exams stoi poza zajęciami podstawowymi i rozliczamy je osobno.
          Minigrupę wyceniamy pod konkretny skład — zależy od liczby dzieci
          i zakresu.
        </p>
      </div>

      <div class="progi">
        {osobneSciezki.map((pozycja) => <PozycjaCennika {...pozycja} />)}
      </div>
    </div>
  </section>

  {/* ZNIŻKI — dwa niezależne mechanizmy */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Zniżki</span>
        <h2 class="tytul-1">Kiedy płacicie mniej</h2>
      </div>

      <div class="siatka siatka--para">
        <article class="karta karta--luzna">
          <h3 class="tytul-3">Rodzeństwo — 10%</h3>
          <p class="tekst-drugi tekst-maly">
            Gdy z centrum korzysta dwoje lub więcej dzieci z jednej rodziny,
            zniżkę naliczamy na tańszy pakiet. Obowiązuje przez cały czas,
            w którym oboje uczestniczą w zajęciach.
          </p>
        </article>

        <article class="karta karta--luzna">
          <h3 class="tytul-3">Polecenie — 50 zł</h3>
          <p class="tekst-drugi tekst-maly">
            Jeśli z Waszego polecenia zapisze się kolejny uczestnik, odejmujemy
            50 zł od Waszej najbliższej raty. Naliczamy po opłaceniu przez niego
            pierwszej raty.
          </p>
        </article>
      </div>

      <p class="tekst-maly tekst-drugi" style="margin-top: var(--space-3); max-width: var(--szerokosc-tekstu);">
        <strong>Oba mechanizmy działają niezależnie.</strong> Zniżka rodzinna
        jest stałym obniżeniem ceny, a polecenie jednorazową nagrodą — polecenie
        nie zabiera zniżki rodzinnej.
      </p>
    </div>
  </section>

  {/* PŁATNOŚĆ I REZYGNACJA */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Płatność</span>
          <h2 class="tytul-1">Dziesięć rat, stała kwota</h2>
        </div>
        <div class="stos">
          <p class="wiodacy">
            Kurs obejmuje cały rok szkolny i opłacacie go w dziesięciu równych
            ratach od września do czerwca.
          </p>
          <ul class="lista-znaczona">
            <li>
              Rata jest stała niezależnie od liczby spotkań w danym miesiącu —
              nie rośnie w miesiącach dłuższych i nie maleje w krótszych
            </li>
            <li>Płatność przelewem na konto centrum</li>
            <li>Fakturę wystawiamy na życzenie, także na firmę</li>
          </ul>

          <h3 class="tytul-4" style="margin-top: var(--space-2);">
            Rezygnacja w trakcie roku
          </h3>
          <p class="tekst-drugi tekst-maly">
            Z ważnego powodu można zrezygnować przed końcem roku szkolnego.
            Miesiąc, w którym zgłosicie rezygnację, jest wtedy ostatnim płatnym
            z dziesięciu — pozostałych rat nie naliczamy.
          </p>
          <p class="tekst-drugi tekst-maly">
            Za ważny powód uznajemy między innymi dłuższą chorobę,
            przeprowadzkę i zmianę szkoły. Lista nie jest zamknięta —
            rozstrzygamy na korzyść rodzica.{" "}
            <a class="link-w-zdaniu" href={url("/regulamin")}>
              Pełne zasady są w regulaminie
            </a>.
          </p>

          <DoUzupelnienia czego="Termin płatności i numer konta">
            Do wpisania dzień miesiąca, do którego wpływa rata, oraz numer
            konta. To jedyne dwie rzeczy, których w tej sekcji jeszcze nie ma —
            a rodzic zapyta o nie w pierwszej rozmowie.
          </DoUzupelnienia>
        </div>
      </div>
    </div>
  </section>

  {/* W CENIE — cztery pozycje, siatka 2×2 */}
  <section class="sekcja">
    <div class="szerokosc">
      <div class="naglowek-sekcji">
        <span class="nadtytul">Bez dopłat</span>
        <h2 class="tytul-1">Co jest w cenie</h2>
      </div>

      <div class="siatka siatka--czworo">
        <article class="karta">
          <h3 class="tytul-4">Materiały i karty pracy</h3>
          <p class="tekst-maly tekst-drugi">
            Wszystko, czego dziecko używa na zajęciach. Nie kupujecie
            podręcznika ani zeszytu ćwiczeń.
          </p>
        </article>
        <article class="karta">
          <h3 class="tytul-4">Konsultacja z prowadzącym</h3>
          <p class="tekst-maly tekst-drugi">
            Rozmowa o postępach dziecka, na Wasze życzenie. Prowadzący mówi
            wprost, co działa, a co nie.
          </p>
        </article>
        <article class="karta">
          <h3 class="tytul-4">Odrobienie nieobecności</h3>
          <p class="tekst-maly tekst-drugi">
            Zajęcia odwołane z wyprzedzeniem odrabiamy w innej grupie tego
            samego poziomu.
          </p>
        </article>
        <article class="karta">
          <h3 class="tytul-4">Wydarzenia otwarte</h3>
          <p class="tekst-maly tekst-drugi">
            Pokazy na koniec semestru i spotkania otwarte centrum. Bez
            osobnego biletu.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* PYTANIA */}
  <section class="sekcja sekcja--karta sekcja--wlos">
    <div class="szerokosc">
      <div class="siatka--wiodaca">
        <div class="stos stos--ciasny">
          <span class="nadtytul">Pytania</span>
          <h2 class="tytul-1">Pytania, które wracają</h2>
          <p class="tekst-drugi tekst-maly">
            Każde z nich i tak padnie w pierwszej rozmowie. Lepiej, żeby
            odpowiedź była tutaj.
          </p>
        </div>
        <div class="pytania">
          {pytania.map((p) => (
            <details>
              <summary>{p.pytanie}</summary>
              <p class="pytania__odpowiedz">{p.odpowiedz}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <ZapisCta
    tytul="Zanim zapłacicie za cokolwiek, przyjdźcie na jedną misję"
    tresc="Bezpłatne zajęcia próbne, bez zobowiązań. Dziecko bierze udział na normalnych zasadach, Wy patrzycie z boku. Potem rozmawiamy."
  />
</Baza>
