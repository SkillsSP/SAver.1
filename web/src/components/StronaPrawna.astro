---
import { dokumentyPrawne } from "../lib/site.js";
import Baza from "../layouts/Baza.astro";
import { url } from "../lib/site.js";
import FotoNaglowka from "./FotoNaglowka.astro";

interface Sekcja {
  tytul: string;
  tresc: string;
  doUstalenia: string;
  /** Zapisy kwestionowane w umowach z konsumentem — wymagają uwagi w pierwszej kolejności. */
  ryzyko?: string;
}

interface Props {
  tytul: string;
  opis: string;
  wstep: string;
  /** Dodatkowe zdanie w ramce ostrzegawczej, jeśli dokument tego wymaga. */
  uwagaWstepna?: string;
  sekcje: Sekcja[];
}

const { tytul, opis, wstep, uwagaWstepna, sekcje } = Astro.props;

/* ==========================================================================
   CO ZOSTAJE NA ŻYWEJ STRONIE, A CO ZNIKA

   Podział nie jest tu techniczny, tylko etyczny, więc wymaga uzasadnienia.

   ZOSTAJE ostrzeżenie u góry, że dokument jest wersją roboczą przed przeglądem
   prawnym. Kuszące jest schowanie go razem z resztą — wygląda nieprofesjonalnie.
   Byłoby to jednak gorsze niż nieprofesjonalne: rodzic czytałby regulamin
   i politykę prywatności w przekonaniu, że to dokumenty gotowe i sprawdzone
   przez prawnika, a nie są. Ostrzeżenie zostaje i będzie zostawać, dopóki
   przegląd się nie odbędzie.

   ZNIKAJĄ notatki robocze przy poszczególnych punktach — „Do ustalenia"
   i „Zapis podwyższonego ryzyka". To lista zadań dla Was i dla prawnika.
   Rodzicowi nie mówi nic poza tym, że ktoś tu jeszcze pracuje, a przy okazji
   wskazuje palcem, które zapisy są najsłabsze. To informacja dla Waszego
   prawnika, nie dla drugiej strony umowy.

   Podgląd wszystkiego w wersji zbudowanej: PUBLIC_POKAZ_NOTY=1 npm run build
   ========================================================================== */
const pokazNotatki =
  import.meta.env.DEV || import.meta.env.PUBLIC_POKAZ_NOTY === "1";
const liczbaRyzyk = sekcje.filter((s) => s.ryzyko).length;
---

{/*
  Wspólny układ dokumentów formalnych. Każda sekcja ma treść widoczną dla
  odwiedzającego, notatkę „do ustalenia" oraz — tam, gdzie to istotne —
  ostrzeżenie o zapisie podwyższonego ryzyka. Obie notatki trzeba usunąć razem
  z komponentem po przeglądzie prawnym.
*/}
{/* Dokumenty formalne nie mają konkurować w wynikach ze stronami oferty,
    i to jest właściwy sposób, żeby ich tam nie było.

    Wcześniej blokował je `Disallow` w robots.txt — a to zakazuje POBIERANIA
    strony, nie jej pokazywania. Google potrafi wtedy zaindeksować sam adres,
    bo widzi do niego odnośniki z cennika i z formularzy, i wyświetlić go bez
    opisu, z adnotacją o braku informacji. Co gorsza, blokada pobierania
    uniemożliwia zobaczenie `noindex`, więc oba mechanizmy naraz działają
    przeciwko sobie.

    `noindex, follow` mówi wprost: nie pokazuj tej strony w wynikach, ale idź
    dalej po odnośnikach. Tak samo zrobione są ukryte podstrony terminarza
    i poradnika. */}
<Baza aktywna="" tytul={tytul} opis={opis} bezIndeksowania>
  {/* Rejestr cichy — zdjęcie ledwo się przebija, bo to dokumenty, nie
      oferta. Ten sam kadr na trzech stronach formalnych jest zamierzony:
      wspólny obraz wiąże je w jedną grupę. */}
  <section
    class="naglowek-strony naglowek-strony--foto naglowek-strony--cichy"
    style="--foto-kadr: center 40%"
  >
    <FotoNaglowka nazwa="art-2" />
    <div class="szerokosc">
      <div class="naglowek-strony__tresc">
        <span class="nadtytul nadtytul--na-marce">Formalności</span>
        <h1 class="tytul-1">{tytul}</h1>
        <p class="hero__zdanie">{wstep}</p>
      </div>
    </div>
  </section>

  <section class="sekcja">
    <div class="szerokosc">
      <div
        class="do-uzupelnienia"
        style="max-width: var(--szerokosc-tekstu); margin-bottom: var(--space-6);"
      >
        <strong>Wersja robocza — wymaga przeglądu prawnego</strong>
        <p>
          {uwagaWstepna ??
            "Ten dokument jest punktem wyjścia, nie gotowym tekstem do publikacji. Treść poniżej opisuje, jak zamierzacie postępować; prawnik musi potwierdzić podstawy prawne, przypisać przepisy i uzupełnić dane podmiotu."}
        </p>
        {liczbaRyzyk > 0 && (
          <p>
            <strong style="text-transform: none; letter-spacing: 0; font-size: inherit;">
              Zapisów oznaczonych jako podwyższonego ryzyka: {liczbaRyzyk}.
            </strong>
            {" "}Od nich zacznijcie rozmowę z prawnikiem.
          </p>
        )}
      </div>

      <div class="stos stos--luzny">
        {sekcje.map((s) => (
          <article class="siatka--wiodaca">
            <h2 class="tytul-3">{s.tytul}</h2>
            <div class="stos stos--ciasny">
              <p class="tekst-drugi">{s.tresc}</p>
              {pokazNotatki && s.ryzyko && (
                <aside class="zapis-ryzyka">
                  <strong>Zapis podwyższonego ryzyka</strong>
                  <p>{s.ryzyko}</p>
                </aside>
              )}
              {pokazNotatki && s.doUstalenia && (
                <aside class="do-uzupelnienia">
                  <strong>Do ustalenia</strong>
                  <p>{s.doUstalenia}</p>
                </aside>
              )}
            </div>
          </article>
        ))}
      </div>

      <p
        class="tekst-maly tekst-drugi"
        style="margin-top: var(--space-6); max-width: var(--szerokosc-tekstu);"
      >
        Pytania dotyczące danych osobowych i zasad uczestnictwa kierujcie przez{" "}
        <a class="link-w-zdaniu" href={url("/kontakt")}>formularz kontaktowy</a>.
        Zasady bezpieczeństwa dziecka opisujemy osobno w{" "}
        <a class="link-w-zdaniu" href={url("/bezpieczenstwo")}>Standardach Ochrony Małoletnich</a>.
      </p>

      {/* DATA OSTATNIEJ ZMIANY. Rodzic ma prawo wiedzieć, czy czyta wersję
          aktualną, czy sprzed dwóch lat — a dokument prawny bez daty nie
          pozwala tego stwierdzić. Data nie bierze się z chwili budowania
          strony i jest to celowe: serwis przebudowuje się przy każdej zmianie
          oferty, więc dokument wyglądałby na świeżo zmieniony, choć nikt go
          nie ruszał. Wpisujemy ją ręcznie w site.js. */}
      <p class="tekst-drobny" style="margin-top: var(--space-2);">
        Ostatnia zmiana dokumentu: {dokumentyPrawne.aktualizacja}.
      </p>
    </div>
  </section>
</Baza>
