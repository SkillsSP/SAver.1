---
import { url } from "../lib/site.js";
---

{/*
  BANER ZGODY I BRAMKA ANALITYKI

  Odtworzone z makiet „Zgoda cookies" i „Analityka — wdrożenie". Zasada jest
  jedna i nienegocjowalna: żaden skrypt analityczny nie ładuje się przed
  zgodą. Konfiguracja siedzi w jednym miejscu (stała ANALYTICS poniżej),
  a dopóki `provider` jest `null`, bramka nie robi nic — baner działa, wybór
  jest zapamiętywany, ale nie ma czego uruchamiać.

  Przycisk „Akceptuję wszystkie" jest kobaltowy, nie koralowy. Koral zostaje
  zarezerwowany dla głównego wezwania na stronie — baner zgody nie ma z nim
  konkurować o wzrok.
*/}
<div
  class="zgoda-cookies"
  data-zgoda
  role="dialog"
  aria-modal="false"
  aria-label="Zgoda na pliki cookies"
  hidden
>
  <div class="zgoda-cookies__panel">
    <h2 class="zgoda-cookies__tytul">Pliki cookies</h2>
    <p class="zgoda-cookies__tresc">
      Niezbędne pliki cookies utrzymują działanie strony i formularza zapisu.
      Analityczne pomagają nam sprawdzić, które treści są dla rodziców
      przydatne — używamy ich tylko z Waszą zgodą. Szczegóły w
      <a href={url("/polityka-prywatnosci")}>polityce prywatności</a>.
    </p>
    <div class="zgoda-cookies__przyciski">
      <button type="button" class="przycisk przycisk--marka" data-zgoda-wszystkie>
        Akceptuję wszystkie
      </button>
      <button type="button" class="przycisk przycisk--obrys" data-zgoda-niezbedne>
        Tylko niezbędne
      </button>
    </div>
    <p class="zgoda-cookies__nota">
      Zgodę możecie w każdej chwili zmienić — odnośnik „Zgody cookies”
      w stopce.
    </p>
  </div>
</div>

<script is:inline>
  (function () {
    var KLUCZ = "sa-cookie-consent";

    /* ── Konfiguracja analityki ──────────────────────────────────────────

       Ustawcie `provider` i wklejcie identyfikator. Dopóki jest `null`, nic się
       nie ładuje i strona nie wysyła ani jednego zapytania na zewnątrz.

         'umami'      — plan bezpłatny na cloud.umami.is albo własny serwer.
                        Bez ciasteczek. UWAGA: lokalizacja serwerów zależy od
                        wariantu — usługa w chmurze stoi poza Unią, wersja
                        postawiona u siebie tam, gdzie ją postawicie. Trzeba to
                        sprawdzić i wpisać do polityki prywatności, bo od tego
                        zależy, czy dochodzi przekazanie danych poza Unię.
         'plausible'  — płatny, bez ciasteczek, serwery deklarowane w Unii.
                        Droższy, ale zdejmuje pytanie o transfer.
         'cloudflare' — działa TYLKO gdy strona stoi za Cloudflare. Serwis stoi
                        na GitHub Pages, więc na dziś ten wariant odpada.
         'ga4'        — Google Analytics. Używa ciasteczek i wysyła dane poza
                        Unię, więc chodzi wyłącznie po zgodzie.

       ── DLACZEGO `bezCiasteczek` MA ZNACZENIE ──────────────────────────────

       Narzędzie, które nic nie zapisuje na urządzeniu, nie wymaga zgody
       z banera — przepis o ciasteczkach dotyczy zapisu i odczytu na
       urządzeniu, a nie samego liczenia odsłon. Trzymanie takiego narzędzia
       za banerem oznacza, że liczy tylko tych, którzy klikną „akceptuję",
       czyli zwykle mniejszość. Dane stają się wtedy bezużyteczne: nie da się
       na nich stwierdzić, czy formularz działa, bo nie wiadomo, ilu ludzi go
       w ogóle zobaczyło.

       To NIE znaczy, że nie ma żadnych obowiązków. Adres IP jest daną osobową
       także przy narzędziu bez ciasteczek, więc potrzebna jest podstawa
       przetwarzania i wzmianka w polityce prywatności — jedno i drugie jest
       opisane w sekcji o analityce na /polityka-prywatnosci. Zgoda z banera
       nie jest do tego potrzebna, informacja tak. */
    var ANALYTICS = {
      provider: null,
      bezCiasteczek: true,
      umamiSrc: "",
      umamiWebsiteId: "",
      plausibleDomena: "",
      cloudflareToken: "",
      ga4Id: "",
    };

    /* Google zawsze za zgodą, niezależnie od ustawienia powyżej — ciasteczka
       i transfer poza Unię wykluczają inne traktowanie. */
    if (ANALYTICS.provider === "ga4") ANALYTICS.bezCiasteczek = false;

    var baner = document.querySelector("[data-zgoda]");
    if (!baner) return;
    var zaladowane = false;

    /* Ładuje skrypt analityki. Przy narzędziu bez ciasteczek wywoływane od
       razu, przy Google — dopiero po zgodzie. */
    function zaladujAnalitykę() {
      if (zaladowane || !ANALYTICS.provider) return;
      zaladowane = true;
      var s = document.createElement("script");
      s.defer = true;
      if (ANALYTICS.provider === "cloudflare") {
        s.src = "https://static.cloudflareinsights.com/beacon.min.js";
        s.setAttribute(
          "data-cf-beacon",
          JSON.stringify({ token: ANALYTICS.cloudflareToken })
        );
      } else if (ANALYTICS.provider === "umami") {
        s.src = ANALYTICS.umamiSrc;
        s.setAttribute("data-website-id", ANALYTICS.umamiWebsiteId);
      } else if (ANALYTICS.provider === "plausible") {
        s.src = "https://plausible.io/js/script.js";
        s.setAttribute("data-domain", ANALYTICS.plausibleDomena);
      } else if (ANALYTICS.provider === "ga4") {
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + ANALYTICS.ga4Id;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", ANALYTICS.ga4Id, { anonymize_ip: true });
      } else {
        return;
      }
      document.head.appendChild(s);
    }

    /* Czy analityka wolno działać. Narzędzie bez ciasteczek — tak, zawsze;
       narzędzie z ciasteczkami — dopiero po zgodzie „akceptuję wszystkie". */
    function analitykaDozwolona(poziom) {
      if (!ANALYTICS.provider) return false;
      return ANALYTICS.bezCiasteczek ? true : poziom === "all";
    }

    /* Jedyny punkt, z którego wolno uruchamiać analitykę. */
    function oglos(poziom) {
      var wolno = analitykaDozwolona(poziom);
      window.saConsent = { level: poziom, analytics: wolno };
      /* Jeden punkt zgłaszania celów, żeby reszta strony mogła wołać saTrack
         bez sprawdzania warunków. */
      window.saTrack = function (nazwa, dane) {
        if (!window.saConsent || !window.saConsent.analytics) return;
        if (window.umami && window.umami.track) window.umami.track(nazwa, dane);
        else if (window.plausible) window.plausible(nazwa, { props: dane });
        else if (window.gtag) window.gtag("event", nazwa, dane || {});
      };
      if (wolno) zaladujAnalitykę();
      window.dispatchEvent(
        new CustomEvent("sa-consent", { detail: window.saConsent })
      );
    }

    function pokaz() {
      baner.hidden = false;
    }
    function schowaj() {
      baner.hidden = true;
    }

    function zdecyduj(poziom) {
      try {
        localStorage.setItem(KLUCZ, poziom);
      } catch (e) {}
      oglos(poziom);
      schowaj();
    }

    var zapisane = null;
    try {
      zapisane = localStorage.getItem(KLUCZ);
    } catch (e) {}

    /* Baner pokazujemy tylko wtedy, gdy jest o co pytać. Przy narzędziu bez
       ciasteczek strona nie zapisuje na urządzeniu niczego poza tym, co jest
       niezbędne do jej działania — pytanie o zgodę byłoby wtedy pytaniem
       pozornym, a baner, który nie zmienia niczego niezależnie od odpowiedzi,
       uczy ludzi klikać bez czytania. Informacja o analityce stoi w polityce
       prywatności, bo obowiązek informacyjny zostaje. */
    var jestOCoPytac = ANALYTICS.provider && !ANALYTICS.bezCiasteczek;

    if (zapisane) oglos(zapisane);
    else if (jestOCoPytac) pokaz();
    else oglos("necessary");

    baner
      .querySelector("[data-zgoda-wszystkie]")
      .addEventListener("click", function () {
        zdecyduj("all");
      });
    baner
      .querySelector("[data-zgoda-niezbedne]")
      .addEventListener("click", function () {
        zdecyduj("necessary");
      });

    /* Odnośnik „Zgody cookies" w stopce otwiera baner ponownie. */
    window.addEventListener("sa-consent-reopen", pokaz);

    /* Dwa cele, które faktycznie mierzą skuteczność strony. Zdarzenia
       wysyłają się z każdej podstrony, z informacją, skąd je wywołano. */
    function zglos(nazwa) {
      if (typeof window.saTrack === "function")
        window.saTrack(nazwa, { skad: location.pathname });
    }
    document.addEventListener(
      "click",
      function (e) {
        var tel = e.target.closest && e.target.closest('a[href^="tel:"]');
        if (tel) zglos("telefon_klik");
      },
      true
    );
    document.addEventListener(
      "submit",
      function () {
        zglos("zapis_formularz");
      },
      true
    );
  })();
</script>
