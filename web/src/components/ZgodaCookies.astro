---
import { url, analityka } from "../lib/site.js";

/* Konfiguracja wchodzi do skryptu przez `define:vars`, więc w kodzie strony
   ląduje wyłącznie to, czego faktycznie używamy. Identyfikatory Google mogą
   być puste — wtedy skrypt Google nie wchodzi na stronę w ogóle. */
const google = analityka.google ?? {};
const konfiguracja = {
  statystyka: analityka.statystyka,
  google: {
    ga4: google.ga4 ?? null,
    ads: google.ads ?? null,
    konwersje: google.konwersje ?? {},
    skrypt: google.skrypt ?? "https://www.googletagmanager.com/gtag/js",
  },
  clarity: {
    id: (analityka.clarity ?? {}).id ?? null,
    skrypt: (analityka.clarity ?? {}).skrypt ?? "https://www.clarity.ms/tag/",
  },
  meta: {
    pixel: (analityka.meta ?? {}).pixel ?? null,
    skrypt: (analityka.meta ?? {}).skrypt ?? "https://connect.facebook.net/en_US/fbevents.js",
  },
};
---

{/*
  BANER ZGODY, TRYB ZGODY GOOGLE I BRAMKA ANALITYKI

  Zasada jest jedna i nienegocjowalna: żaden skrypt analityczny ani reklamowy
  nie ładuje się przed zgodą.

  DWIE KATEGORIE, NIE JEDNA. Statystyka i marketing to dwa różne cele i rodzic
  może chcieć zgodzić się na jeden, a odmówić drugiego. Wcześniej baner miał
  jeden przełącznik „wszystko albo nic" — kto chciał dać nam statystyki, ale
  nie chciał reklamy, odmawiał obu rzeczy naraz.

  PERSONALIZACJA REKLAM JEST ODMAWIANA ZAWSZE. `ad_personalization` zostaje
  `denied` niezależnie od tego, co rodzic kliknie, bo świadomie nie prowadzimy
  remarketingu — Google ma policzyć telefon i zgłoszenie, a nie budować listę
  dzieci do ścigania reklamą po innych stronach. To nie jest ustawienie do
  przestawienia w locie: zmiana wymaga ruszenia trzech miejsc naraz — tutaj,
  w site.js i w polityce prywatności.

  ZGODNOŚĆ WSTECZ. Wcześniejsze wersje zapisywały pod tym samym kluczem zwykły
  napis „necessary" albo „all". Odczytujemy oba, bo w przeglądarkach rodziców,
  którzy już byli na stronie, siedzi stara wartość — potraktowanie jej jako
  braku decyzji oznaczałoby pytanie ich drugi raz o to samo.
*/}
<div
  class="zgoda-cookies"
  data-zgoda
  role="dialog"
  aria-modal="false"
  aria-labelledby="zgoda-tytul"
  hidden
>
  <div class="zgoda-cookies__panel">
    <h2 class="zgoda-cookies__tytul" id="zgoda-tytul">Pliki cookies</h2>
    <p class="zgoda-cookies__tresc">
      Statystyki pomagają nam sprawdzić, których treści rodzice faktycznie
      szukają. Reklama pozwala policzyć, które ogłoszenie przyprowadziło do nas
      dziecko — a Facebookowi pokazać nasze reklamy osobom, które już tu były.
      Szczegóły w{" "}
      <a href={url("/polityka-prywatnosci")}>polityce prywatności</a>.
    </p>

    <fieldset class="zgoda-cookies__wybory">
      <legend class="wizualnie-ukryte">Na co się zgadzacie</legend>

      <label class="zgoda-cookies__wybor">
        <input type="checkbox" data-zgoda-statystyka checked />
        <span>
          <strong>Statystyka</strong>
          Ile osób odwiedza stronę, których podstron szukają i gdzie się na
          niej gubią. Nagrywamy ruch po stronie — bez tego, co wpisujecie
          w formularzu. Microsoft zapisuje przy tym własny identyfikator
          urządzenia.
        </span>
      </label>

      <label class="zgoda-cookies__wybor">
        <input type="checkbox" data-zgoda-marketing />
        <span>
          <strong>Marketing</strong>
          Pomiar skuteczności reklam Google i Facebooka. Facebook może na tej
          podstawie pokazywać Wam nasze reklamy także na innych stronach.
        </span>
      </label>
    </fieldset>

    <div class="zgoda-cookies__przyciski">
      <button type="button" class="przycisk przycisk--marka" data-zgoda-wszystkie>
        Akceptuję wszystkie
      </button>
      <button type="button" class="przycisk przycisk--obrys" data-zgoda-wybrane>
        Zapisz wybór
      </button>
      {/* Odmowa musi być tak samo widoczna jak zgoda — inaczej wybór jest
          pozorny, a zgoda zebrana w ten sposób nie jest zgodą. */}
      <button type="button" class="przycisk przycisk--obrys" data-zgoda-niezbedne>
        Tylko niezbędne
      </button>
    </div>

    <p class="zgoda-cookies__nota">
      Zgodę możecie w każdej chwili zmienić — odnośnik „Zgody cookies”
      w stopce.
    </p>
  </div>
</div>

<script is:inline define:vars={{ konfiguracja }}>
  (function () {
    var KLUCZ = "sa-cookie-consent";
    var baner = document.querySelector("[data-zgoda]");
    if (!baner) return;

    var zaladowaneUmami = false;
    var zaladowaneGoogle = false;
    var g = konfiguracja.google;
    var googleWlaczone = Boolean(g.ga4 || g.ads);
    var c = konfiguracja.clarity;
    var clarityWlaczone = Boolean(c && c.id);
    var zaladowaneClarity = false;
    var m = konfiguracja.meta;
    var metaWlaczone = Boolean(m && m.pixel);
    var zaladowaneMeta = false;

    /* ---- Tryb zgody Google, wersja druga ---------------------------------
       Ustawiamy domyślne odmowy ZANIM cokolwiek się załaduje. Bez tego kroku
       Google w Europie ogranicza dane z kampanii, nawet gdy rodzic później
       wyrazi zgodę: liczy się to, w jakim stanie tag zastał stronę.

       `wait_for_update` daje pół sekundy na decyzję z pamięci przeglądarki,
       żeby powracający rodzic nie był liczony jako odmowa. */
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = window.gtag || gtag;
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      wait_for_update: 500,
    });

    function zaladujUmami() {
      var u = konfiguracja.statystyka;
      if (zaladowaneUmami || !u || !u.src) return;
      zaladowaneUmami = true;
      var s = document.createElement("script");
      s.defer = true;
      s.src = u.src;
      var a = u.atrybuty || {};
      for (var k in a) if (Object.prototype.hasOwnProperty.call(a, k)) s.setAttribute(k, a[k]);
      document.head.appendChild(s);
    }

    function zaladujGoogle() {
      if (zaladowaneGoogle || !googleWlaczone) return;
      zaladowaneGoogle = true;
      var id = g.ga4 || g.ads;
      var s = document.createElement("script");
      s.async = true;
      s.src = g.skrypt + "?id=" + encodeURIComponent(id);
      document.head.appendChild(s);
      gtag("js", new Date());
      if (g.ga4) gtag("config", g.ga4, { anonymize_ip: true });
      if (g.ads) gtag("config", g.ads);
    }

    /* Microsoft Clarity — mapy kliknięć i nagrania sesji. Kategoria
       „statystyka", bo nie służy reklamie, tylko zobaczeniu, gdzie rodzic się
       gubi. Po załadowaniu wołamy `clarity("consent")`, żeby po stronie
       Microsoftu też był ślad, że zgoda padła — sam fakt uruchomienia skryptu
       im tego nie mówi. */
    function zaladujClarity() {
      if (zaladowaneClarity || !clarityWlaczone) return;
      zaladowaneClarity = true;
      window.clarity = window.clarity || function () {
        (window.clarity.q = window.clarity.q || []).push(arguments);
      };
      var t = document.createElement("script");
      t.async = true;
      t.src = c.skrypt + c.id;
      document.head.appendChild(t);
      window.clarity("consent");
    }

    /* Piksel Meta. Ładowany wyłącznie po zgodzie na kategorię „marketing".

       Znacznik `<noscript>` z obrazkiem spod facebook.com/tr, który Meta
       dokłada do swojego kodu, jest tu pominięty ŚWIADOMIE: odpalałby się przy
       wyłączonym JavaScripcie, czyli tam, gdzie nie da się ani zapytać o zgodę,
       ani jej sprawdzić. Wersja dla odwiedzających bez skryptów nie może być
       wersją bez zgody. */
    function zaladujMete() {
      if (zaladowaneMeta || !metaWlaczone) return;
      zaladowaneMeta = true;
      if (!window.fbq) {
        var n = (window.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        });
        if (!window._fbq) window._fbq = n;
        n.push = n; n.loaded = true; n.version = "2.0"; n.queue = [];
        var t = document.createElement("script");
        t.async = true;
        t.src = m.skrypt;
        document.head.appendChild(t);
      }
      window.fbq("init", m.pixel);
      window.fbq("track", "PageView");
    }

    /* ---- Odczyt i zapis decyzji ------------------------------------------ */
    function odczytaj() {
      var surowe = null;
      try { surowe = localStorage.getItem(KLUCZ); } catch (e) { return null; }
      if (!surowe) return null;
      /* Stary zapis: zwykły napis zamiast obiektu. */
      if (surowe === "all") return { statystyka: true, marketing: true };
      if (surowe === "necessary") return { statystyka: false, marketing: false };
      try {
        var o = JSON.parse(surowe);
        if (o && typeof o === "object")
          return { statystyka: Boolean(o.statystyka), marketing: Boolean(o.marketing) };
      } catch (e) {}
      return null;
    }

    function zapisz(z) {
      try {
        localStorage.setItem(KLUCZ, JSON.stringify({
          statystyka: z.statystyka, marketing: z.marketing, v: 2,
        }));
      } catch (e) {}
    }

    /* ---- Jedyny punkt, z którego wolno cokolwiek uruchomić --------------- */
    function oglos(z) {
      window.saConsent = {
        statystyka: z.statystyka,
        marketing: z.marketing,
        /* Zachowane dla kodu, który pytał o `analytics`. */
        analytics: z.statystyka,
      };

      gtag("consent", "update", {
        analytics_storage: z.statystyka ? "granted" : "denied",
        ad_storage: z.marketing ? "granted" : "denied",
        ad_user_data: z.marketing ? "granted" : "denied",
        /* Zawsze odmowa — patrz komentarz na górze pliku. */
        ad_personalization: "denied",
      });

      window.saTrack = function (nazwa, dane) {
        if (window.saConsent && window.saConsent.statystyka) {
          if (window.umami && window.umami.track) window.umami.track(nazwa, dane);
          else if (window.plausible) window.plausible(nazwa, { props: dane });
          if (g.ga4 && window.gtag) window.gtag("event", nazwa, dane || {});
        }
        /* Konwersja Google Ads to osobna zgoda i osobne zdarzenie. Bez etykiety
           z panelu Ads nie ma czego wysłać — kampania policzyłaby wtedy samo
           wejście, a nie telefon. */
        /* Meta ma własne nazwy zdarzeń standardowych: zgłoszenie to „Lead",
           telefon to „Contact". Bez nich kampania liczy same wejścia. */
        if (window.saConsent && window.saConsent.marketing && window.fbq) {
          window.fbq("track", nazwa === "telefon_klik" ? "Contact" : "Lead");
        }
        if (window.saConsent && window.saConsent.marketing && window.gtag) {
          var etykieta = (g.konwersje || {})[nazwa === "telefon_klik" ? "telefon" : "formularz"];
          if (etykieta) window.gtag("event", "conversion", { send_to: etykieta });
        }
      };

      if (z.statystyka) { zaladujUmami(); zaladujClarity(); }
      if ((z.statystyka && g.ga4) || (z.marketing && g.ads)) zaladujGoogle();
      if (z.marketing) zaladujMete();

      window.dispatchEvent(new CustomEvent("sa-consent", { detail: window.saConsent }));
    }

    function pokaz() { baner.hidden = false; }
    function schowaj() { baner.hidden = true; }

    var polaStat = baner.querySelector("[data-zgoda-statystyka]");
    var polaMark = baner.querySelector("[data-zgoda-marketing]");

    function zdecyduj(z) {
      zapisz(z);
      oglos(z);
      schowaj();
    }

    var decyzja = odczytaj();
    if (decyzja) {
      oglos(decyzja);
      if (polaStat) polaStat.checked = decyzja.statystyka;
      if (polaMark) polaMark.checked = decyzja.marketing;
    } else {
      /* Brak decyzji znaczy brak zgody — do czasu kliknięcia nic nie chodzi. */
      oglos({ statystyka: false, marketing: false });
      pokaz();
    }

    baner.querySelector("[data-zgoda-wszystkie]").addEventListener("click", function () {
      if (polaStat) polaStat.checked = true;
      if (polaMark) polaMark.checked = true;
      zdecyduj({ statystyka: true, marketing: true });
    });
    baner.querySelector("[data-zgoda-wybrane]").addEventListener("click", function () {
      zdecyduj({
        statystyka: Boolean(polaStat && polaStat.checked),
        marketing: Boolean(polaMark && polaMark.checked),
      });
    });
    baner.querySelector("[data-zgoda-niezbedne]").addEventListener("click", function () {
      if (polaStat) polaStat.checked = false;
      if (polaMark) polaMark.checked = false;
      zdecyduj({ statystyka: false, marketing: false });
    });

    /* Odnośnik „Zgody cookies" w stopce otwiera baner ponownie. */
    window.addEventListener("sa-consent-reopen", pokaz);

    /* Dwa cele, które faktycznie mierzą skuteczność strony i kampanii. */
    function zglos(nazwa) {
      if (typeof window.saTrack === "function")
        window.saTrack(nazwa, { skad: location.pathname });
    }
    document.addEventListener("click", function (e) {
      var tel = e.target.closest && e.target.closest('a[href^="tel:"]');
      if (tel) zglos("telefon_klik");
    }, true);
    document.addEventListener("submit", function () {
      zglos("zapis_formularz");
    }, true);
  })();
</script>
