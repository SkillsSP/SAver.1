---
import Marka from "./Marka.astro";
import {
  firma,
  url,
  telefonHref,
  telefonTekst,
  emailTekst,
  adresTekst,
} from "../lib/site.js";

const tel = telefonHref();
const rok = new Date().getFullYear();
---

<footer class="stopka">
  <div class="szerokosc">
    <div class="stopka__siatka">
      <div class="stopka__marka">
        <Marka wariant="stopka" jakoLink={false} />
        <address class="stopka__dane">
          <span>{adresTekst()}</span>
          {tel ? (
            <strong><a href={tel}>{telefonTekst()}</a></strong>
          ) : (
            <strong>{telefonTekst()}</strong>
          )}
          {firma.email ? (
            <a href={`mailto:${firma.email}`}>{emailTekst()}</a>
          ) : (
            <span>{emailTekst()}</span>
          )}
        </address>
        <p class="stopka__godziny">
          Biuro czynne {firma.godzinyBiura ?? "— godziny w uzupełnieniu"}
        </p>
      </div>

      <div>
        <h2>Oferta</h2>
        <ul class="stopka__linki">
          <li><a href={url("/podstawowe")}>Zajęcia podstawowe</a></li>
          <li><a href={url("/fakultety")}>Fakultety</a></li>
          <li><a href={url("/indywidualne")}>Zajęcia indywidualne</a></li>
          <li><a href={url("/exams")}>Exams</a></li>
          <li><a href={url("/cennik")}>Cennik</a></li>
        </ul>
      </div>

      <div>
        <h2>O centrum</h2>
        <ul class="stopka__linki">
          <li><a href={url("/o-nas")}>O nas</a></li>
          <li><a href={url("/metoda")}>Metoda</a></li>
          <li><a href={url("/metoda#grupy")}>Podział na grupy wiekowe</a></li>
          <li><a href={url("/bezpieczenstwo")}>Bezpieczeństwo</a></li>
        </ul>
      </div>

      <div>
        <h2>Formalności</h2>
        <ul class="stopka__linki">
          <li><a href={url("/polityka-prywatnosci")}>Polityka prywatności</a></li>
          <li><a href={url("/regulamin")}>Regulamin</a></li>
          <li><a href={url("/klauzula-rodo")}>Klauzula RODO</a></li>
          <li>
            {/* Otwiera baner ponownie — zgodę można zmienić w każdej chwili. */}
            <button type="button" class="stopka__zgody" data-otworz-zgody>
              Zgody cookies
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="stopka__dol">
      <span>
        © {rok} {firma.nazwa}
        {firma.nip ? ` · NIP ${firma.nip}` : " · NIP w uzupełnieniu"}
      </span>
      <span>{firma.miasto}, Polska</span>
    </div>
  </div>
</footer>

<script is:inline>
  document.querySelector("[data-otworz-zgody]")?.addEventListener("click", function () {
    window.dispatchEvent(new CustomEvent("sa-consent-reopen"));
  });
</script>
