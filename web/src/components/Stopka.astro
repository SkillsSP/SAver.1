---
import Marka from "./Marka.astro";
import Spolecznosciowe from "./Spolecznosciowe.astro";
import {
  firma,
  url,
  telefonHref,
  telefonTekst,
  emailTekst,
  adresTekst,
  terminarz,
  poradnik,
} from "../lib/site.js";

const tel = telefonHref();
const rok = new Date().getFullYear();

/* Ten sam warunek co w nagłówku i na stronach — jedno źródło prawdy o tym,
   czy sekcja w ogóle istnieje dla odwiedzającego. */
const pokazTerminarz = terminarz.pokazuj && terminarz.dni.length > 0;
const pokazPoradnik = poradnik.length > 0;
---

{/* Kotwica `#kontakt` zostaje na stopce mimo powstania osobnej podstrony.
    Adres `/#kontakt` mógł trafić do materiałów drukowanych i do wysłanych
    wiadomości; usunięcie identyfikatora zamieniłoby te odnośniki w skok
    donikąd. Kosztuje jeden atrybut, więc nie ma powodu tego ruszać. */}
<footer class="stopka" id="kontakt">
  <div class="szerokosc">
    <div class="stopka__siatka">
      <div class="stopka__marka">
        <Marka wariant="stopka" jakoLink={false} />
        <address class="stopka__dane">
          <span>{adresTekst()}</span>
          {tel ? (
            <strong><a href={tel}>{telefonTekst()}</a></strong>
          ) : (
            <strong>{telefonTekst()}</strong>
          )}
          {firma.email ? (
            <a href={`mailto:${firma.email}`}>{emailTekst()}</a>
          ) : (
            <span>{emailTekst()}</span>
          )}
        </address>
        <Spolecznosciowe />
        {/* Wiersz z godzinami pojawia się DOPIERO wtedy, gdy godziny są znane.
            Wcześniej stało tu „Biuro czynne — godziny w uzupełnieniu", czyli
            zdanie, które nie niesie żadnej informacji poza tą, że strona jest
            niedokończona. Brak wiersza jest lepszy niż wiersz o braku. */}
        {firma.godzinyBiura && (
          <p class="stopka__godziny">Biuro czynne {firma.godzinyBiura}</p>
        )}
      </div>

      <div>
        <h2>Oferta</h2>
        <ul class="stopka__linki">
          <li><a href={url("/podstawowe")}>Zajęcia podstawowe</a></li>
          <li><a href={url("/fakultety")}>Fakultety</a></li>
          <li><a href={url("/indywidualne")}>Zajęcia indywidualne</a></li>
          <li><a href={url("/exams")}>Exams</a></li>
          <li><a href={url("/exams/egzamin-osmoklasisty")}>Exams · egzamin ósmoklasisty</a></li>
          <li><a href={url("/exams/matura")}>Exams · matura</a></li>
          <li><a href={url("/cennik")}>Cennik</a></li>
          {pokazTerminarz && (
            <li><a href={url("/terminarz")}>Terminarz zajęć</a></li>
          )}
        </ul>
      </div>

      <div>
        <h2>O centrum</h2>
        <ul class="stopka__linki">
          <li><a href={url("/o-nas")}>O nas</a></li>
          <li><a href={url("/metoda")}>Metoda</a></li>
          <li><a href={url("/metoda#grupy")}>Podział na grupy wiekowe</a></li>
          <li><a href={url("/bezpieczenstwo")}>Bezpieczeństwo</a></li>
          <li><a href={url("/kontakt")}>Kontakt</a></li>
          <li><a href={url("/zapisy")}>Zapisy na zajęcia próbne</a></li>
          {pokazPoradnik && (
            <li><a href={url("/poradnik")}>Poradnik dla rodziców</a></li>
          )}
        </ul>
      </div>

      <div>
        <h2>Formalności</h2>
        <ul class="stopka__linki">
          <li><a href={url("/polityka-prywatnosci")}>Polityka prywatności</a></li>
          <li><a href={url("/regulamin")}>Regulamin</a></li>
          <li><a href={url("/klauzula-rodo")}>Klauzula RODO</a></li>
          <li>
            {/* Otwiera baner ponownie — zgodę można zmienić w każdej chwili. */}
            <button type="button" class="stopka__zgody" data-otworz-zgody>
              Zgody cookies
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="stopka__dol">
      <span>
        © {rok} {firma.nazwa}
        {/* Ta sama zasada co przy godzinach: numer albo nic. */}
        {firma.nip ? ` · NIP ${firma.nip}` : ""}
      </span>
      <span>{firma.miasto}, Polska</span>
    </div>
  </div>
</footer>

<script is:inline>
  document.querySelector("[data-otworz-zgody]")?.addEventListener("click", function () {
    window.dispatchEvent(new CustomEvent("sa-consent-reopen"));
  });
</script>
