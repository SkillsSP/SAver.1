---
import { url } from "../lib/site.js";

/* ==========================================================================
   LOCKUP MARKI — sygnet zastępuje literę „S", reszta nazwy jest tekstem.

   Wartości przepisane dosłownie z makiet (Nawigacja.dc.html, Stopka.dc.html).
   NIE wyliczamy ich proporcjonalnie: stosunek znaku do napisu jest w obu
   miejscach inny (38:22 w pasku, 19:18 w stopce), a wyrównanie zależy od
   obu naraz — od głębokości wydłużeń dolnych pisma i od tego, gdzie kończy
   się rysunek wewnątrz kwadratu 64×64. Skalowanie jednej korekty drugą
   rozjeżdżało znak względem linii pisma.

   Dwa pliki znaku, nie jeden — to rozróżnienie z pakietu logo:
     · sygnet.svg  — wersja z oczami, od 32 px wzwyż,
     · favicon.svg — wersja bez oczu, 16–24 px; przy tej wielkości oczy
       zlewają się w plamę, więc rysunek jest celowo uproszczony.
   ========================================================================== */

const PRESETY = {
  pasek: {
    znak: "/logo/skills-academy-sygnet.svg",
    znakRewers: "/logo/skills-academy-sygnet-rewers.svg",
    sygnet: 38,
    tekst: 22,
    pion: -0.2,
    docisk: -3.7,
    przesuniecie: -7,
  },
  stopka: {
    znak: "/logo/skills-academy-favicon.svg",
    znakRewers: "/logo/skills-academy-sygnet-rewers.svg",
    sygnet: 19,
    tekst: 18,
    pion: -1.1,
    docisk: -1.3,
    przesuniecie: -5,
  },
};

interface Props {
  wariant?: "pasek" | "stopka";
  /** Wersja na ciemnym tle — znak w kontrze. */
  rewers?: boolean;
  /** Odnośnik w pasku, zwykły blok w stopce (stopka i tak linkuje logiem obok). */
  jakoLink?: boolean;
}

const { wariant = "pasek", rewers = false, jakoLink = true } = Astro.props;
const p = PRESETY[wariant];
const plik = rewers ? p.znakRewers : p.znak;
const Element = jakoLink ? "a" : "span";
---

<Element
  class="marka"
  href={jakoLink ? url("/") : undefined}
  style={`margin-left:${p.przesuniecie}px`}
>
  {/* SYGNET W DWÓCH WERSJACH, WYBIERANY PRZEZ PRZEGLĄDARKĘ.

      Znak podstawowy jest grafitowy — na kremowym tle czyta się doskonale,
      na ciemnym zamienia się w dziurę z pomarańczową kreską. Zobaczyłem to
      dopiero na zrzucie ekranu; żadna liczba tego nie pokazuje, bo obrazek
      nie ma kontrastu tekstu do zmierzenia.

      Wersja w kontrze istniała w zestawie znaków od początku i komponent
      umiał ją pokazać — tylko nikt jej nie włączał, bo do wyboru służył
      atrybut ustawiany ręcznie, a tryb ciemny jest decyzją przeglądarki,
      nie autora strony.

      `picture` rozwiązuje to bez skryptu i bez podwójnego pobierania:
      przeglądarka bierze JEDEN plik, ten pasujący do trybu, i przełącza go
      sama, gdy odwiedzający zmieni ustawienie systemu w trakcie czytania. */}
  <picture>
    <source srcset={url(p.znakRewers)} media="(prefers-color-scheme: dark)" />
    <img
      loading="eager"
      decoding="async"
      src={url(plik)}
      alt=""
      aria-hidden="true"
      width={p.sygnet}
      height={p.sygnet}
      style={`width:${p.sygnet}px;height:${p.sygnet}px;margin-right:${p.docisk}px;transform:translateY(${p.pion}px)`}
    />
  </picture>
  {/* Litera „S" zostaje w kodzie, ale schowana wizualnie, bo rysuje ją sygnet
      obok. Dzięki temu wyszukiwarka i zaznaczenie tekstu dostają pełne
      „Skills Academy", a nie „kills Academy".

      ROLA I ETYKIETA SĄ TU KONIECZNE, mimo że sam tekst brzmi poprawnie.
      Nazwa dostępna liczona przez przeglądarkę skleja wkłady kolejnych węzłów
      spacją, więc ukryte „S" i sąsiadujące „kills Academy" dawały czytnikowi
      ekranu „S kills Academy" — z przerwą po pierwszej literze. Widać to
      wyłącznie w drzewie dostępności; `textContent` jest cały czas poprawny.

      Sama etykieta nie wystarczy: działa na odnośniku w nagłówku, ale nie na
      stopce, gdzie marka odnośnikiem nie jest — tam etykieta na zwykłym
      elemencie jest pomijana. Stąd `role="img"`: znak marki JEST jednostką
      graficzną, a nie zdaniem do przeczytania po literze, więc ta rola opisuje
      go zgodnie z prawdą i sprawia, że etykieta działa w obu przypadkach.

      Ukryte „S" zostaje bez `aria-hidden` — dzięki temu `textContent` nadal
      daje pełne „Skills Academy" przy zaznaczaniu tekstu i dla wyszukiwarki. */}
  <span
    class="marka__napis"
    style={`font-size:${p.tekst}px`}
    role="img"
    aria-label="Skills Academy"
  >
    <span class="wizualnie-ukryte">S</span>kills Academy
  </span>
</Element>
