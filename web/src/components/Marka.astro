---
import { url } from "../lib/site.js";

/* ==========================================================================
   LOCKUP MARKI — sygnet zastępuje literę „S", reszta nazwy jest tekstem.

   Wartości przepisane dosłownie z makiet (Nawigacja.dc.html, Stopka.dc.html).
   NIE wyliczamy ich proporcjonalnie: stosunek znaku do napisu jest w obu
   miejscach inny (38:22 w pasku, 19:18 w stopce), a wyrównanie zależy od
   obu naraz — od głębokości wydłużeń dolnych pisma i od tego, gdzie kończy
   się rysunek wewnątrz kwadratu 64×64. Skalowanie jednej korekty drugą
   rozjeżdżało znak względem linii pisma.

   Dwa pliki znaku, nie jeden — to rozróżnienie z pakietu logo:
     · sygnet.svg  — wersja z oczami, od 32 px wzwyż,
     · favicon.svg — wersja bez oczu, 16–24 px; przy tej wielkości oczy
       zlewają się w plamę, więc rysunek jest celowo uproszczony.
   ========================================================================== */

const PRESETY = {
  pasek: {
    znak: "/logo/skills-academy-sygnet.svg",
    znakRewers: "/logo/skills-academy-sygnet-rewers.svg",
    sygnet: 38,
    tekst: 22,
    pion: -0.2,
    docisk: -3.7,
    przesuniecie: -7,
  },
  stopka: {
    znak: "/logo/skills-academy-favicon.svg",
    znakRewers: "/logo/skills-academy-sygnet-rewers.svg",
    sygnet: 19,
    tekst: 18,
    pion: -1.1,
    docisk: -1.3,
    przesuniecie: -5,
  },
};

interface Props {
  wariant?: "pasek" | "stopka";
  /** Wersja na ciemnym tle — znak w kontrze. */
  rewers?: boolean;
  /** Odnośnik w pasku, zwykły blok w stopce (stopka i tak linkuje logiem obok). */
  jakoLink?: boolean;
}

const { wariant = "pasek", rewers = false, jakoLink = true } = Astro.props;
const p = PRESETY[wariant];
const plik = rewers ? p.znakRewers : p.znak;
const Element = jakoLink ? "a" : "span";
---

<Element
  class="marka"
  href={jakoLink ? url("/") : undefined}
  style={`margin-left:${p.przesuniecie}px`}
>
  <img
    src={url(plik)}
    alt=""
    aria-hidden="true"
    width={p.sygnet}
    height={p.sygnet}
    style={`width:${p.sygnet}px;height:${p.sygnet}px;margin-right:${p.docisk}px;transform:translateY(${p.pion}px)`}
  />
  {/* Litera „S" zostaje w kodzie, ale schowana wizualnie — czytnik ekranu
      i wyszukiwarka dostają „Skills Academy", a nie „kills Academy". */}
  <span class="marka__napis" style={`font-size:${p.tekst}px`}>
    <span class="wizualnie-ukryte">S</span>kills Academy
  </span>
</Element>
